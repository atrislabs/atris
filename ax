function buildChatDogfoodCases(loopCount = 25) {
  const count = Math.max(1, Number(loopCount) || 25);
  const cases = [];
  for (let i = 0; i < count; i += 1) {
    cases.push({ ...CHAT_DOGFOOD_BASE_CASES[i % CHAT_DOGFOOD_BASE_CASES.length], index: i + 1 });
  }
  return cases;
