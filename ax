const http = require('http');
const https = require('https');
const os = require('os');
const path = require('path');
const readline = require('readline');
const { loadCredentials } = require('./utils/auth');

const EXIT_WORDS = new Set(['exit', 'quit', ':q']);
const BACKEND = {
  host: '127.0.0.1',
  port: 8000,
  path: '/api/atris2/turn'
};
