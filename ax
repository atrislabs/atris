const CONNECTION_CAPABILITIES_PATH = '/api/atris2/connection-capabilities';
const ATRIS2_CONNECTION_STATUS_PATH = '/api/atris2/connection-status';
const CONNECTOR_NAMES = {
  gmail: 'Gmail',
  google_calendar: 'Google Calendar',
  google_drive: 'Google Drive',
  google_docs: 'Google Docs',
  github: 'GitHub',
  slack: 'Slack',
  linear: 'Linear',
  notion: 'Notion',
  hubspot: 'HubSpot',
  twitter: 'Twitter',
  microsoft: 'Microsoft',
  discord: 'Discord',
  jira: 'Jira',
  linkedin: 'LinkedIn',
  whatsapp: 'WhatsApp',
  salesforce: 'Salesforce'
};
const CONNECTOR_SCOPES = {
  gmail: ['mail'],
  google_calendar: ['calendar'],
  google_drive: ['drive'],
  google_docs: ['docs'],
  github: ['repos', 'issues', 'pull_requests'],
  slack: ['messages'],
  linear: ['issues'],
  notion: ['pages', 'databases'],
  hubspot: ['crm']
};
const ANSI = {
  reset: '\x1b[0m',
  bold: '\x1b[1m',
  dim: '\x1b[2m',
  muted: '\x1b[90m',
  accent: '\x1b[36m',
  ok: '\x1b[32m'
};

function modelForMode(mode) {
  if (mode === 'code-fast') return CODE_FAST.model;
  return mode === 'fast' ? 'atris:fast' : 'atris:pro';
}

function formatDuration(ms) {
  const value = Number(ms) || 0;
  if (value < 1000) return `${Math.max(0, Math.round(value))}ms`;
  const totalSeconds = Math.max(1, Math.round(value / 1000));
  return formatSeconds(totalSeconds);
}

function formatSeconds(totalSeconds) {
  if (totalSeconds < 60) return `${totalSeconds}s`;
  const minutes = Math.floor(totalSeconds / 60);
  const seconds = totalSeconds % 60;
  return seconds ? `${minutes}m ${seconds}s` : `${minutes}m`;
}

function formatHeader({ mode = 'pro', cwd = process.cwd(), chat = false } = {}) {
  const label = mode === 'code-fast' ? 'Atris Code Fast' : mode === 'fast' ? 'Atris 2 Fast' : 'Atris 2 Pro';
  return [
    `${label}${chat ? ' chat' : ''} (${modelForMode(mode)})`,
    cwd,
    chat ? 'exit with exit, quit, or :q' : '',
  ].filter(Boolean).join('\n');
}

function formatUsage() {
  return [
    'ax - Atris local/code agent',
    '',
    'Usage:',
    '  ax [--pro|--fast|--code-fast] [--local|--cloud] <message>',
    '  ax [--pro|--fast|--code-fast] [--local|--cloud] --chat',
    '  ax [--pro|--fast|--code-fast] --doctor',
    '  ax [--fast] --benchmark',
    '',
    'Modes:',
    '  --pro   local workspace agent, deeper tool loop',
    '  --fast  local workspace agent, faster low-latency turns',
    '  --code-fast  Atris Code Fast public lane (composer-2-5-fast)',
    '  --local force local workspace tools',
    '  --cloud force authenticated cloud connectors/chat',
    '',
    'Examples:',
    '  ax --pro find the config file and explain it',
    '  ax --fast what files are here',
    '  ax --code-fast explain this error',
    '  ax --fast what is on my calendar today',
    '  ax --pro --chat',
  ].join('\n');
}

function timestampForFile(date = new Date()) {
  return date.toISOString().replace(/[:.]/g, '-');
}

function stripAnsi(value) {
  return String(value || '').replace(/\x1b\[[0-?]*[ -/]*[@-~]/g, '');
}

function createRunLogger({ cwd = process.cwd(), mode = 'pro', kind = 'play', output = process.stdout } = {}) {
  if (process.env.AX_AUTO_LOG === '0') return null;
  if (output !== process.stdout && output !== process.stderr && !output.isTTY) return null;

  const baseDir = fs.existsSync(path.join(cwd, 'atris'))
    ? path.join(cwd, 'atris', 'runs')
    : path.join(os.homedir(), '.atris', 'runs');
  fs.mkdirSync(baseDir, { recursive: true });
  const logPath = path.join(baseDir, `ax-${kind}-${timestampForFile()}.log`);
  fs.appendFileSync(logPath, [
    `command: ${process.argv.join(' ')}`,
    `cwd: ${cwd}`,
    `mode: ${mode}`,
    `started_at: ${new Date().toISOString()}`,
    '',
  ].join('\n'));

  const writeLog = (chunk) => {
    fs.appendFileSync(logPath, stripAnsi(chunk));
  };
  const teeOutput = {
    isTTY: Boolean(output && output.isTTY),
    write(chunk) {
      const text = String(chunk || '');
      if (output && typeof output.write === 'function') output.write(text);
      writeLog(text);
      return true;
    }
  };

  return {
    path: logPath,
    output: teeOutput,
    write: writeLog,
    close(exitCode = 0) {
      writeLog(`\nexit_code: ${exitCode}\nfinished_at: ${new Date().toISOString()}\n`);
    }
  };
}

function backendBaseUrl() {
  return (process.env.AX_BACKEND_URL
    || process.env.OBELISK_LOCAL_ATRIS2_BACKEND_URL
    || process.env.OBELISK_ATRIS2_BACKEND_URL
    || DEFAULT_BACKEND_BASE).replace(/\/$/, '');
}

function backendUrl() {
  return new URL(BACKEND.path, backendBaseUrl()).toString();
}

function backendPathUrl(pathname) {
  return new URL(pathname, backendBaseUrl()).toString();
}

function codeFastBaseUrl() {
  return (process.env.AX_CODE_FAST_BACKEND_URL
    || process.env.AX_CODE_FAST_API_BASE
    || process.env.ATRIS_API_BASE
    || CODE_FAST.publicBase).replace(/\/$/, '');
}

function codeFastUrl() {
  return new URL(CODE_FAST.path, codeFastBaseUrl()).toString();
}

function isLoopbackUrl(value) {
  try {
    const parsed = new URL(value);
    return ['127.0.0.1', 'localhost', '::1'].includes(parsed.hostname);
  } catch (_) {
    return false;
  }
}

function isCodeFastLocal(options = {}) {
  const route = options.route === 'local' || options.forceLocal ? 'local' : 'cloud';
  return route === 'local' && isLoopbackUrl(options.codeFastBaseUrl || codeFastBaseUrl());
}

function buildRunProfile(options = {}) {
  const mode = normalizeMode(options.mode);
  const cwd = options.cwd || process.cwd();
  if (mode === 'code-fast') {
    const route = options.route === 'local' || options.forceLocal ? 'local' : 'cloud';
    return {
      endpoint: codeFastUrl(),
      mode,
      route,
      model: CODE_FAST.model,
      workspace_path: isCodeFastLocal(options) ? cwd : 'cloud scratch',
      max_turns: 1,
      streaming: false,
      runtime: isCodeFastLocal(options) ? 'local Cursor SDK through backend' : 'authenticated Code Fast cloud scratch',
      reasoning: 'Composer 2.5 fast lane; charges 10 credits per public turn'
    };
  }
  const route = resolveRoute(options.message || 'doctor', options);
  const payload = buildPayload(options.message || 'doctor', { mode, cwd, route });
  return {
    endpoint: backendUrl(),
    mode,
    route,
    model: payload.model,
    workspace_path: payload.workspace_path || 'cloud',
    max_turns: payload.max_turns,
    streaming: true,
    runtime: route === 'cloud' ? 'authenticated cloud connectors/chat' : 'local workspace',
    reasoning: mode === 'pro'
      ? 'backend reports run row; Pro workspace tool loop uses API default medium'
      : 'backend reports run row; Fast workspace tool loop uses provider default'
  };
}

function formatRunProfile(profile, options = {}) {
  const rows = [
    ['mode', `${profile.mode} (${profile.model})`],
    ['endpoint', profile.endpoint],
    ['route', profile.route || 'auto'],
    ['workspace', formatPathSubject(profile.workspace_path, options)],
    ['turns', String(profile.max_turns)],
    ['streaming', profile.streaming ? 'yes' : 'no'],
    ['runtime', profile.runtime],
    ['thinking', profile.reasoning],
  ];
  return rows.map(([label, value]) => formatAuxRow(label, value, options)).join('\n');
}

function canonicalConnectorId(value) {
  return String(value || '').trim().toLowerCase().replace(/-/g, '_');
}

function connectorDisplayName(id) {
  const key = canonicalConnectorId(id);
  if (CONNECTOR_NAMES[key]) return CONNECTOR_NAMES[key];
  return key.split('_').map(part => part ? part[0].toUpperCase() + part.slice(1) : '').join(' ');
}

function authToken() {
  if (process.env.OBELISK_AUTH_TOKEN) return process.env.OBELISK_AUTH_TOKEN;
  if (process.env.ATRIS_TOKEN) return process.env.ATRIS_TOKEN;
  try {
    const creds = loadCredentials();
    return creds && creds.token ? creds.token : '';
  } catch (_) {
    return '';
  }
}

function authUserId() {
  if (process.env.OBELISK_USER_ID) return process.env.OBELISK_USER_ID;
  if (process.env.ATRIS_USER_ID) return process.env.ATRIS_USER_ID;
  try {
    const creds = loadCredentials();
    return creds && creds.user_id ? creds.user_id : '';
  } catch (_) {
    return '';
  }
}

function isLoopbackBackend() {
  try {
    const parsed = new URL(backendBaseUrl());
    return ['127.0.0.1', 'localhost', '::1'].includes(parsed.hostname);
  } catch (_) {
    return false;
  }
}

function requestJson(pathname, { token = authToken(), timeoutMs = 6000 } = {}) {
  const url = backendPathUrl(pathname);
  const parsed = new URL(url);
  const transport = parsed.protocol === 'https:' ? https : http;
  return new Promise((resolve) => {
    const req = transport.request({
      method: 'GET',
      hostname: parsed.hostname,
      port: parsed.port || (parsed.protocol === 'https:' ? 443 : 80),
      path: `${parsed.pathname}${parsed.search}`,
      headers: {
        Accept: 'application/json',
        ...(token ? { Authorization: `Bearer ${token}` } : {})
      }
    }, (res) => {
      const chunks = [];
      res.on('data', chunk => chunks.push(chunk));
      res.on('end', () => {
        const text = Buffer.concat(chunks).toString('utf8');
        try {
          resolve({ ok: res.statusCode >= 200 && res.statusCode < 300, status: res.statusCode, data: text ? JSON.parse(text) : null, text });
        } catch (_) {
          resolve({ ok: false, status: res.statusCode, data: null, text });
        }
      });
    });
    req.on('error', error => resolve({ ok: false, status: 0, data: null, text: '', error: error.message }));
    req.setTimeout(timeoutMs, () => {
      req.destroy();
      resolve({ ok: false, status: 0, data: null, text: '', error: `timeout after ${timeoutMs}ms` });
    });
    req.end();
  });
}

function defaultAuthority(id) {
  const key = canonicalConnectorId(id);
  if (key === 'gmail') return { list_messages: 'read_only', get_message: 'read_only', send_message: 'approval_required' };
  if (key === 'google_calendar') return { list_events: 'read_only', get_event: 'read_only', create_event: 'approval_required' };
  if (key === 'google_drive') return { list_files: 'read_only', search_files: 'read_only', download_file: 'read_only', upload_file: 'approval_required' };
  if (key === 'google_docs') return { list_documents: 'read_only', get_document: 'read_only', create_document: 'approval_required' };
  if (key === 'github') return { list_repos: 'read_only', get_repo: 'read_only', list_issues: 'read_only', create_issue: 'approval_required' };
  if (key === 'slack') return { list_channels: 'read_only', list_messages: 'read_only', post_message: 'approval_required' };
  if (key === 'linear') return { list_issues: 'read_only', get_issue: 'read_only', create_issue: 'approval_required' };
  if (key === 'notion') return { search: 'read_only', get_page: 'read_only', create_page: 'approval_required' };
  if (key === 'hubspot') return { list_contacts: 'read_only', search_contacts: 'read_only', create_contact: 'approval_required' };
  return { inspect_status: 'read_only' };
}

function connectionFromStatus(id, connected, contractConnector = null) {
  const key = canonicalConnectorId(id);
  const authority = contractConnector && contractConnector.authority && typeof contractConnector.authority === 'object'
    ? contractConnector.authority
    : defaultAuthority(key);
  return {
    id: key,
    name: connectorDisplayName(key),
    connected: connected === true,
    local: false,
    actions: Object.keys(authority),
    scopes: CONNECTOR_SCOPES[key] || [],
    authority,
    source: 'ax_integrations_status'
  };
}

function statusConnected(statuses, id) {
  const keys = [id, id.replace(/_/g, '-'), canonicalConnectorId(id)];
  for (const key of keys) {
    const value = statuses[key];
    if (value === true) return true;
    if (value && typeof value === 'object') {
      if (value.connected === true) return true;
      if (String(value.status || '').toLowerCase() === 'connected') return true;
    }
  }
  return false;
}

function cachedIntegrationStatus(options = {}) {
  const homeDir = options.homeDir || os.homedir();
  try {
    const raw = fs.readFileSync(path.join(homeDir, '.obelisk', 'integrations-status.json'), 'utf8');
    const parsed = JSON.parse(raw);
    if (parsed && parsed.status && typeof parsed.status === 'object') return parsed.status;
    if (parsed && parsed.statuses && typeof parsed.statuses === 'object') return parsed.statuses;
    if (parsed && typeof parsed === 'object') return parsed;
  } catch (_) {
    return {};
  }
  return {};
}

async function buildConnectionContext(options = {}) {
  const token = options.token || authToken();
  const localStatusUserId = isLoopbackBackend() ? authUserId() : '';
  const statusPath = localStatusUserId
    ? `${ATRIS2_CONNECTION_STATUS_PATH}?connection_user_id=${encodeURIComponent(localStatusUserId)}`
    : CONNECTION_STATUS_PATH;
  const [statusRes, contractRes] = await Promise.all([
    options.statusRes
      ? Promise.resolve(options.statusRes)
      : localStatusUserId || token
        ? requestJson(statusPath, { token: localStatusUserId ? '' : token })
        : Promise.resolve({ ok: false, data: null }),
    options.contractRes ? Promise.resolve(options.contractRes) : requestJson(CONNECTION_CAPABILITIES_PATH, { token: '' })
  ]);
  const statusData = statusRes.ok && statusRes.data && typeof statusRes.data === 'object' ? statusRes.data : {};
  const backendStatuses = statusData.statuses && typeof statusData.statuses === 'object' ? statusData.statuses : statusData;
  const cacheStatuses = statusRes.ok ? {} : cachedIntegrationStatus({ homeDir: options.integrationStatusHomeDir });
  const statuses = Object.keys(backendStatuses).length ? backendStatuses : cacheStatuses;
  const statusSource = Object.keys(backendStatuses).length
    ? 'backend'
    : Object.keys(cacheStatuses).length
      ? 'local_cache'
      : 'fallback';
  const contractConnectors = new Map();
  if (contractRes.ok && contractRes.data && Array.isArray(contractRes.data.connectors)) {
    for (const connector of contractRes.data.connectors) {
      const key = canonicalConnectorId(connector.id);
      if (key) contractConnectors.set(key, connector);
    }
  }
  const ids = new Set([
    ...Object.keys(CONNECTOR_NAMES),
    ...Object.keys(statuses).map(canonicalConnectorId),
    ...contractConnectors.keys(),
  ]);
  const connections = [...ids].sort().map(id => connectionFromStatus(
    id,
    statusConnected(statuses, id),
    contractConnectors.get(id)
  ));
  connections.push({
    id: 'computer.local',
    name: 'This Mac workspace',
    connected: options.localWorkspace === true,
    local: true,
    status: options.localWorkspace === true ? 'available' : 'cloud_only',
    actions: ['inspect_status', 'use_local_workspace'],
    scopes: ['computer', 'workspace'],
    authority: { inspect_status: 'read_only', use_local_workspace: 'read_only' },
    source: 'ax'
  });
  return {
    schema: 'atris.connection_capabilities.v1',
    source: 'ax',
    stale: false,
    connection_status_source: statusSource,
    status_source: statusSource,
    capability_contract_source: contractRes.ok ? 'backend' : 'fallback',
    capability_contract_schema: contractRes.data && contractRes.data.schema,
    capability_contract_connectors: contractConnectors.size || undefined,
    connections
  };
}

function mentionsConnector(message) {
  return /\b(gmail|email|mail|inbox|calendar|events?|meetings?|schedule|google drive|drive|docs?|sheets?|github|slack|linear|notion|hubspot|integrations?|connectors?|connections?|connected apps?|connected tools?)\b/i.test(message || '');
}

function connectorWriteIntent(message) {
  return mentionsConnector(message) && /\b(send|post|dm|message|reply|draft|compose|schedule|book|create|update|delete|archive|move|share|comment|invite)\b/i.test(message || '');
}

function workspaceIntent(message) {
  return /\b(files?|folders?|repo|workspace|project|directory|tree|read|open|inspect|search|grep|find|locate|where|edit|write|change|modify|patch|fix|test|tests?|build|src|source|code|diff|git|backend|frontend|atris task|atris xp|xp game|career xp|agentxp|todo|map)\b/i.test(message || '');
}

function githubWorkspaceIntent(message) {
  const text = String(message || '');
  if (!/\bgithub\b/i.test(text)) return false;
  return /\b(push|commit|commits?|branch|branches|checkout|merge|rebase|tag|release|pr|pull request|pull-request|repo change|code change|small change)\b/i.test(text);
}

function resolveRoute(message, options = {}) {
  if (options.route === 'local' || options.forceLocal) return 'local';
  if (options.route === 'cloud' || options.forceCloud) return 'cloud';
  if (githubWorkspaceIntent(message)) return 'local';
  if (mentionsConnector(message) && !workspaceIntent(message)) return 'cloud';
  return 'local';
}

function normalizeMode(mode) {
  if (mode === 'code-fast' || mode === 'code') return 'code-fast';
  return mode === 'fast' ? 'fast' : 'pro';
}

function formatPrompt() {
  return '› ';
}

function formatWorkingLine(ms) {
  const totalSeconds = Math.max(1, Math.round((Number(ms) || 0) / 1000));
  return `• Working (${formatSeconds(totalSeconds)} • ctrl-c to interrupt)`;
}

function formatDoneLine(ms) {
  return `— Worked for ${formatDuration(ms)} —`;
}

function useColor(options = {}) {
  if (options.color === false) return false;
  if (process.env.NO_COLOR) return false;
  return Boolean(options.color || options.isTTY);
}

function paint(text, codes, options = {}) {
  if (!useColor(options)) return String(text);
  return `${codes.join('')}${text}${ANSI.reset}`;
}

function renderTerminalMarkdown(text, options = {}) {
  let rendered = String(text || '');
  const codeSpans = [];
  rendered = rendered.replace(/`([^`\n]+)`/g, (_, code) => {
    const token = `\u0000CODE${codeSpans.length}\u0000`;
    codeSpans.push(code);
    return token;
  });
  rendered = rendered.replace(/^#{1,6}\s+(.+)$/gm, (_, title) => paint(title, [ANSI.bold], options));
  rendered = rendered.replace(/\*\*([^*\n]+)\*\*/g, (_, value) => paint(value, [ANSI.bold], options));
  rendered = rendered.replace(/__([^_\n]+)__/g, (_, value) => paint(value, [ANSI.bold], options));
  rendered = rendered.replace(/\u0000CODE(\d+)\u0000/g, (_, index) => paint(codeSpans[Number(index)] || '', [ANSI.accent], options));
  return rendered;
}

function resetMarkdownState(state) {
  state.markdownMode = 'normal';
  state.markdownBuffer = '';
  state.markdownCarry = '';
}

function ensureMarkdownState(state) {
  if (!state.markdownMode) state.markdownMode = 'normal';
  if (typeof state.markdownBuffer !== 'string') state.markdownBuffer = '';
  if (typeof state.markdownCarry !== 'string') state.markdownCarry = '';
}

function renderStreamingMarkdown(state, text, options = {}) {
  ensureMarkdownState(state);
  const input = `${state.markdownCarry || ''}${String(text || '')}`;
  state.markdownCarry = '';
  let out = '';

  for (let i = 0; i < input.length;) {
    const char = input[i];
    const next = input[i + 1];

    if (state.markdownMode === 'normal') {
      if (char === '*' && next === undefined) {
        state.markdownCarry = '*';
        break;
      }
      if (char === '*' && next === '*') {
        state.markdownMode = 'bold';
        state.markdownBuffer = '';
        i += 2;
        continue;
      }
      if (char === '`') {
        state.markdownMode = 'code';
        state.markdownBuffer = '';
        i += 1;
        continue;
      }
      out += char;
      i += 1;
      continue;
    }

    if (state.markdownMode === 'bold') {
      if (char === '*' && next === undefined) {
        state.markdownCarry = '*';
        break;
      }
      if (char === '*' && next === '*') {
        out += paint(state.markdownBuffer, [ANSI.bold], options);
        state.markdownMode = 'normal';
        state.markdownBuffer = '';
        i += 2;
        continue;
      }
      state.markdownBuffer += char;
      i += 1;
      continue;
    }

    if (state.markdownMode === 'code') {
      if (char === '`') {
        out += paint(state.markdownBuffer, [ANSI.accent], options);
        state.markdownMode = 'normal';
        state.markdownBuffer = '';
        i += 1;
        continue;
      }
      state.markdownBuffer += char;
      i += 1;
      continue;
    }
  }

  return out;
}

function flushStreamingMarkdown(state, output) {
  ensureMarkdownState(state);
  let out = state.markdownCarry || '';
  if (state.markdownMode === 'bold' && state.markdownBuffer) {
    out += paint(state.markdownBuffer, [ANSI.bold], output);
  } else if (state.markdownMode === 'code' && state.markdownBuffer) {
    out += paint(state.markdownBuffer, [ANSI.accent], output);
  }
  resetMarkdownState(state);
  if (out) output.write(out);
  return out;
}

function truncateMiddle(value, limit = 120) {
  const text = String(value || '');
  if (text.length <= limit) return text;
  const head = Math.max(8, Math.floor((limit - 3) * 0.6));
  const tail = Math.max(8, limit - 3 - head);
  return `${text.slice(0, head)}...${text.slice(-tail)}`;
}

function formatPathSubject(value, options = {}) {
  const raw = truncateMiddle(String(value || '').trim(), options.limit || 120);
  if (!raw) return '';
  if (raw === '.' || raw === '/' || raw.endsWith('/')) {
    return paint(raw, [ANSI.accent], options);
  }

  const slash = raw.lastIndexOf('/');
  if (slash === -1) return paint(raw, [ANSI.bold, ANSI.accent], options);

  const parent = raw.slice(0, slash + 1);
  const filename = raw.slice(slash + 1);
  return `${paint(parent, [ANSI.muted], options)}  ${paint(filename, [ANSI.bold, ANSI.accent], options)}`;
}

function formatAuxRow(label, value, options = {}) {
  const tag = String(label || '').padEnd(4);
  const color = label === 'ok' ? [ANSI.ok] : [ANSI.muted];
  return `  ${paint(tag, color, options)}  ${value}`;
}

function createProgressReporter(output, options = {}) {
  const enabled = options.showProgress !== false;
  const isTty = Boolean(output && output.isTTY);
  const startedAt = Date.now();
  let interval = null;
  let timeout = null;
  let shown = false;
  let closed = false;

  const render = () => {
    if (!enabled || closed) return;
    const line = formatWorkingLine(Date.now() - startedAt);
    if (isTty) {
      output.write(`\r${line}\x1b[K`);
    } else if (!shown) {
      output.write(`${line}\n`);
    }
    shown = true;
  };

  return {
    start() {
      if (!enabled) return;
      timeout = setTimeout(() => {
        render();
        if (isTty) interval = setInterval(render, 1000);
      }, 700);
    },
    clear() {
      if (!isTty || !shown || closed) return;
      output.write('\r\x1b[K');
      shown = false;
    },
    stop() {
      closed = true;
      clearTimeout(timeout);
      clearInterval(interval);
      if (isTty && shown) output.write('\r\x1b[K');
      shown = false;
    }
  };
}

function parseSseBlock(block) {
  const data = String(block || '')
    .split(/\r?\n/)
    .filter(line => line.startsWith('data:'))
    .map(line => line.replace(/^data:\s?/, ''))
    .join('\n')
    .trim();

  if (!data || data === '[DONE]') return null;
  return JSON.parse(data);
}

function summarizeToolInput(block) {
  const options = arguments[1] || {};
  const tool = block.tool || 'tool';
  const input = block.input || {};
  const toolName = paint(tool, [ANSI.bold], options);
  const pathValue = input.file_path || input.path;
  if (input.command) return `${toolName}  ${truncateMiddle(input.command, 120)}`;
  if (input.pattern || input.query) {
    const pattern = truncateMiddle(input.pattern || input.query, 80);
    return pathValue
      ? `${toolName}  ${pattern}  in  ${formatPathSubject(pathValue, options)}`
      : `${toolName}  ${pattern}`;
  }
  if (pathValue) return `${toolName}  ${formatPathSubject(pathValue, options)}`;
  const subject = input.type || '';
  return subject ? `${toolName}  ${String(subject).slice(0, 120)}` : toolName;
}

function summarizeToolResult(result) {
  const options = arguments[1] || {};
  const content = String(result.content || '');
  if (!content) return 'done';

  try {
    const parsed = JSON.parse(content);
    if (parsed.error) return `error: ${parsed.error}`;
    if (Array.isArray(parsed.matches)) {
      const where = parsed.path ? `  in  ${formatPathSubject(parsed.path, options)}` : '';
      return `${parsed.matches.length} matches${where}`;
    }
    if (Array.isArray(parsed.files) || Array.isArray(parsed.dirs)) {
      const parts = [];
      if (Array.isArray(parsed.files)) parts.push(`${parsed.files.length} files`);
      if (Array.isArray(parsed.dirs)) parts.push(`${parsed.dirs.length} dirs`);
      const where = parsed.path ? `  in  ${formatPathSubject(parsed.path, options)}` : '';
      return `${parts.join(' / ')}${where}`;
    }
    if (parsed.path && parsed.status) return `${parsed.status}  ${formatPathSubject(parsed.path, options)}`;
    if (parsed.path) return formatPathSubject(parsed.path, options);
    if (parsed.status) return parsed.status;
  } catch (_) {
    // Bash output and older streams can be plain text.
  }

  return content.length > 120 ? `${content.slice(0, 117)}...` : content;
}

function formatStatusMessage(message) {
  const text = String(message || '').trim();
  if (!text || text === 'complete') return null;
  if (text === 'retrying_with_required_local_tool') return null;
  return text.replace(/_/g, ' ');
}

function formatSystemInit(event, options = {}) {
  const runtime = event.tool_runtime || {};
  const model = runtime.tool_model || runtime.chat_model || event.model || '';
  const mode = runtime.mode ? String(runtime.mode).replace(/_/g, ' ') : '';
  const thinking = runtime.reasoning_effort ? `thinking ${runtime.reasoning_effort}` : '';
  const parts = [mode || 'runtime', model, thinking].filter(Boolean);
  return parts.length ? parts.join('  ') : null;
}

function clearRetriedText(state) {
  state.pendingText = '';
  state.output = '';
  state.wroteText = false;
  state.lastChar = '\n';
  state.inAuxBlock = false;
  resetMarkdownState(state);
}

function stopProgress(state) {
  if (!state.progress) return;
  state.progress.stop();
  state.progress = null;
}

function flushPendingText(state, output) {
  const hasMarkdownRemainder = output && output.isTTY && (
    state.markdownCarry
    || state.markdownBuffer
    || (state.markdownMode && state.markdownMode !== 'normal')
  );
  if (!state.pendingText && !hasMarkdownRemainder) return;
  stopProgress(state);
  if (state.inAuxBlock && state.lastChar === '\n') output.write('\n');
  if (state.pendingText) output.write(output && output.isTTY ? renderTerminalMarkdown(state.pendingText, output) : state.pendingText);
  const flushedMarkdown = hasMarkdownRemainder ? flushStreamingMarkdown(state, output) : '';
  state.wroteText = true;
  state.wroteActivity = true;
  const written = `${state.pendingText || ''}${flushedMarkdown || ''}`;
  state.lastChar = written.slice(-1);
  state.pendingText = '';
  state.inAuxBlock = false;
}

function writeStreamingText(state, output, content) {
  if (!content) return;
  stopProgress(state);
  if (state.inAuxBlock && state.lastChar === '\n') output.write('\n');
  const rendered = renderStreamingMarkdown(state, content, output);
  if (rendered) output.write(rendered);
  state.wroteText = true;
  state.wroteActivity = true;
  state.lastChar = String(rendered || content).slice(-1);
  state.inAuxBlock = false;
}

function writeAuxLine(state, output, line) {
  if (!line) return;
  stopProgress(state);
  if (state.wroteText && state.lastChar !== '\n') output.write('\n');
  if (!state.inAuxBlock && state.wroteActivity && state.lastChar === '\n') output.write('\n');
  output.write(`${line}\n`);
  state.wroteActivity = true;
  state.lastChar = '\n';
  state.inAuxBlock = true;
}

function compactHistory(history, limit = 8) {
  return history
    .slice(-limit)
    .map(turn => `${turn.role}: ${String(turn.content || '').slice(0, 1200)}`)
    .join('\n');
}

function findAtrisWorkspaceRoot(start = process.cwd()) {
  let dir = path.resolve(start);
  while (true) {
    if (fs.existsSync(path.join(dir, 'atris')) || fs.existsSync(path.join(dir, '.atris'))) return dir;
    const parent = path.dirname(dir);
    if (parent === dir) return null;
    dir = parent;
  }
}

function zeroShotModelTierForMode(mode) {
  const normalized = normalizeMode(mode);
  if (normalized === 'code-fast') return 'fast';
  if (normalized === 'fast') return 'fast';
  if (normalized === 'pro') return 'pro';
  return null;
}

function isOwnerGatedZeroShotPacket(packet) {
  const decision = packet && packet.decision;
  return Boolean(decision && (decision.lane === 'owner_gate' || decision.owner_action));
}

function buildAxZeroShotPacket(options = {}) {
  if (Object.prototype.hasOwnProperty.call(options, 'zeroShotPacket')) return options.zeroShotPacket;
  if (options.zeroShot === false) return null;
  const root = findAtrisWorkspaceRoot(options.cwd || process.cwd());
  if (!root) return null;
  try {
    const { buildPacket } = require('./commands/zero-shot');
    const defaultPacket = buildPacket({ cwd: root });
    if (isOwnerGatedZeroShotPacket(defaultPacket)) return defaultPacket;
    const modelTier = zeroShotModelTierForMode(options.mode);
    return modelTier ? buildPacket({ cwd: root, model: modelTier }) : defaultPacket;
  } catch (_) {
    return null;
  }
}

function formatZeroShotMessage(packet, options = {}) {
  if (!packet || !packet.decision || !packet.commands) return '';
  const decision = packet.decision;
  const commands = packet.commands;
  const route = [decision.lane, decision.horizon, decision.model_tier].filter(Boolean).join(' | ') || 'unknown';
  const focus = [decision.selected_ref, decision.selected_title].filter(Boolean).join(' - ') || 'the current workspace';
  const models = packet.routes && packet.routes.models ? packet.routes.models : {};
  const horizons = packet.routes && packet.routes.horizons ? packet.routes.horizons : {};
  const modelCommands = commands.model_prompt || {};
  const horizonCommands = commands.horizon_prompt || {};
  const firstCommand = commands.first_command || commands.next_command || 'atris 0-shot --prompt';
  const lines = [
    '0-shot context for this ax turn:',
    `- ax mode: ${normalizeMode(options.mode)}`,
    `- route: ${route}`,
    `- focus: ${focus}`,
  ];
  if (decision.reason) lines.push(`- why: ${decision.reason}`);
  if (decision.requested_model_tier) {
    lines.push(`- model request: ${decision.requested_model_tier} | match=${decision.model_tier_match}`);
  }
  lines.push(`- run first: ${firstCommand}`);
  lines.push(`- menu: ${commands.zero_shot_all || 'atris 0-shot --all'}`);
  lines.push(`- prompt: ${commands.zero_shot_prompt || 'atris 0-shot --prompt'}`);
  lines.push(`- model buckets: fast=${models.fast?.count || 0} pro=${models.pro?.count || 0} validator=${models.validator?.count || 0} human=${models.human?.count || 0}`);
  lines.push(`- horizon buckets: now=${horizons.now || 0} review=${horizons.immediate_review || 0} long=${horizons.long_term || 0} blocked=${horizons.blocked || 0} orient=${horizons.orient || 0}`);
  if (modelCommands.fast || modelCommands.pro || modelCommands.validator || modelCommands.human) {
    lines.push(`- model prompts: fast=${modelCommands.fast || 'atris 0-shot --model fast --prompt'}; pro=${modelCommands.pro || 'atris 0-shot --model pro --prompt'}; validator=${modelCommands.validator || 'atris 0-shot --model validator --prompt'}; human=${modelCommands.human || 'atris 0-shot --model human --prompt'}`);
  }
  if (horizonCommands.now || horizonCommands.review || horizonCommands.long || horizonCommands.blocked || horizonCommands.orient) {
    lines.push(`- horizon prompts: now=${horizonCommands.now || 'atris 0-shot --horizon now --prompt'}; review=${horizonCommands.review || 'atris 0-shot --horizon review --prompt'}; long=${horizonCommands.long || 'atris 0-shot --horizon long --prompt'}; blocked=${horizonCommands.blocked || 'atris 0-shot --horizon blocked --prompt'}; orient=${horizonCommands.orient || 'atris 0-shot --horizon orient --prompt'}`);
  }
  if (decision.owner_action) lines.push(`- owner gate: ${decision.owner_action}`);
  if (decision.safe_agent_action) lines.push(`- agent-safe action: ${decision.safe_agent_action}`);
  lines.push('- boundary: if owner-gated, do only the agent-safe action; do not mutate tasks, accept human gates, send externally, merge, or publish from this prompt.');
  return lines.join('\n');
}

function buildMessage(message, history = [], options = {}) {
  const trimmed = String(message || '').trim();
  const body = !history.length ? trimmed : [
    'Continue this terminal coding-agent conversation in the same workspace.',
    'Use local tools when the user asks about files, code, tests, or edits.',
    '',
    'Recent conversation:',
    compactHistory(history),
    '',
    `Current user message: ${trimmed}`,
  ].join('\n');
  const zeroShot = formatZeroShotMessage(options.zeroShotPacket, { mode: options.mode });
  return zeroShot ? `${zeroShot}\n\nUser request:\n${body}` : body;
}

function buildPayload(message, options = {}) {
  const mode = normalizeMode(options.mode);
  const route = resolveRoute(message, options);
  const local = route !== 'cloud';
  const zeroShotPacket = buildAxZeroShotPacket({ ...options, mode });
  const payload = {
    message: buildMessage(message, options.history || [], { mode, zeroShotPacket }),
    model: modelForMode(mode),
    max_turns: local ? (mode === 'pro' ? 14 : 8) : 1,
    verify_command: 'true'
  };
  if (local) {
    payload.workspace_path = options.cwd || process.cwd();
  }
  if (options.connectionContext) {
    payload.connection_context = options.connectionContext;
  }
  if (!local && options.connectionUserId) {
    payload.connection_user_id = options.connectionUserId;
  }
  if (!local && connectorWriteIntent(message)) {
    payload.allow_external_actions = true;
    payload.cleanup_external_actions = true;
    payload.max_turns = mode === 'pro' ? 4 : 2;
  }
  return payload;
}

function buildCodeFastPayload(message, options = {}) {
  const zeroShotPacket = buildAxZeroShotPacket({ ...options, mode: 'code-fast' });
  const payload = {
    message: buildMessage(message, options.history || [], { mode: 'code-fast', zeroShotPacket }),
    model: CODE_FAST.model,
    timeout_seconds: Number(options.timeoutSeconds || 180)
  };
  if (isCodeFastLocal(options)) {
    payload.workspace_path = options.cwd || process.cwd();
  }
  return payload;
}

function codeFastWorkspaceNotice(result) {
  const workspace = result && typeof result === 'object' ? result.workspace || {} : {};
  const billing = result && typeof result === 'object' ? result.billing || {} : {};
  const mode = workspace.mode || billing.workspace_mode || '';
  const persistence = workspace.persistence || billing.workspace_persistence || '';
  if (mode === 'cloud_scratch' || persistence === 'ephemeral') {
    return 'cloud scratch files are temporary and are not saved to your Mac';
  }
  return null;
}

function handleEvent(event, state, output) {
  if (!event || typeof event !== 'object') return;
  state.events.push(event);

  if (event.type === 'system_init') {
    state.runtime = event;
    writeAuxLine(state, output, formatAuxRow('run', formatSystemInit(event, output), output));
    return;
  }

  if ((event.type === 'text_delta' || event.type === 'text') && event.content) {
    state.output += event.content;
    if (output && output.isTTY) writeStreamingText(state, output, event.content);
    else state.pendingText += event.content;
    return;
  }

  if (event.type === 'assistant_blocks' && Array.isArray(event.blocks)) {
    for (const block of event.blocks) {
      if (block && block.type === 'tool_use') {
        flushPendingText(state, output);
        writeAuxLine(state, output, formatAuxRow('tool', summarizeToolInput(block, output), output));
      }
    }
    return;
  }

  if (event.type === 'tool_results' && Array.isArray(event.results)) {
    for (const result of event.results) {
      flushPendingText(state, output);
      writeAuxLine(state, output, formatAuxRow('ok', summarizeToolResult(result, output), output));
    }
    return;
  }

  if (event.type === 'status' && event.message && event.message !== 'complete') {
    if (event.message === 'retrying_with_required_local_tool') {
      clearRetriedText(state);
      return;
    }
    flushPendingText(state, output);
    writeAuxLine(state, output, formatAuxRow('info', formatStatusMessage(event.message), output));
    return;
  }

  if (event.type === 'result' && event.result && !state.output) {
    const content = String(event.result || '');
    state.output += content;
    if (output && output.isTTY) writeStreamingText(state, output, content);
    else state.pendingText += content;
    return;
  }

  if (event.type === 'error' || event.error) {
    state.errors.push(event.error || event.message || 'Atris2 stream error');
  }
}

async function postTurn(message, options = {}) {
  const route = resolveRoute(message, options);
  const local = route !== 'cloud';
  const token = authToken();
  const shouldSendConnectionContext = options.connectionContext
    || route === 'cloud'
    || mentionsConnector(message)
    || /\b(can you use|can you access|connected|connections?|integrations?|tools?|capabilities)\b/i.test(message || '');
  const connectionContext = options.connectionContext || (shouldSendConnectionContext
    ? await buildConnectionContext({ token, localWorkspace: local })
    : null);
  const connectionUserId = !local && isLoopbackBackend() ? authUserId() : '';
  const payload = buildPayload(message, { ...options, route, connectionContext, connectionUserId });
  const postData = JSON.stringify(payload);
  const output = options.output || process.stdout;
  const timeoutMs = payload.model === 'atris:pro' ? 180000 : 60000;
  const turnUrl = new URL(backendUrl());
  const transport = turnUrl.protocol === 'https:' ? https : http;
  const state = {
    events: [],
    errors: [],
    output: '',
    pendingText: '',
    wroteText: false,
    wroteActivity: false,
    durationMs: 0,
    lastChar: '\n',
    progress: null,
    inAuxBlock: false,
    markdownMode: 'normal',
    markdownBuffer: '',
    markdownCarry: ''
  };

  return new Promise((resolve, reject) => {
    let settled = false;
    const startedAt = Date.now();
    state.progress = createProgressReporter(output, options);
    state.progress.start();

    const finish = (error, value) => {
      if (settled) return;
      settled = true;
      if (state.progress) state.progress.stop();
      state.progress = null;
      state.durationMs = Date.now() - startedAt;
      if (error) reject(error);
      else resolve(value);
    };

    const req = transport.request({
      hostname: turnUrl.hostname,
      port: turnUrl.port || (turnUrl.protocol === 'https:' ? 443 : 80),
      path: `${turnUrl.pathname}${turnUrl.search}`,
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Content-Length': Buffer.byteLength(postData),
        Accept: 'text/event-stream',
        ...(token ? { Authorization: `Bearer ${token}` } : {})
      }
    }, (res) => {
      res.setEncoding('utf8');
      let buffer = '';
      let rawBody = '';

      res.on('data', (chunk) => {
        if (res.statusCode < 200 || res.statusCode >= 300) {
          rawBody += chunk;
          return;
        }

        buffer += chunk;
        let boundary = buffer.indexOf('\n\n');
        while (boundary !== -1) {
          const block = buffer.slice(0, boundary);
          buffer = buffer.slice(boundary + 2);
          try {
            handleEvent(parseSseBlock(block), state, output);
          } catch (error) {
            state.errors.push(`bad_sse_event: ${error.message}`);
          }
          boundary = buffer.indexOf('\n\n');
        }
      });

      res.on('end', () => {
        if (res.statusCode < 200 || res.statusCode >= 300) {
          try {
            const parsed = JSON.parse(rawBody);
            finish(new Error(parsed.detail || parsed.error || `HTTP ${res.statusCode}`));
          } catch (_) {
            finish(new Error(rawBody || `HTTP ${res.statusCode}`));
          }
          return;
        }

        if (buffer.trim()) {
          try {
            handleEvent(parseSseBlock(buffer), state, output);
          } catch (error) {
            state.errors.push(`bad_sse_event: ${error.message}`);
          }
        }

        if (state.errors.length) {
          finish(new Error(state.errors.join('; ')));
          return;
        }

        flushPendingText(state, output);
        finish(null, state);
      });
    });

    req.on('error', finish);
    req.setTimeout(timeoutMs, () => {
      finish(new Error(`Request timeout after ${timeoutMs / 1000}s`));
      req.destroy();
    });
    req.write(postData);
    req.end();
  });
}

async function postCodeFastTurn(message, options = {}) {
  const route = options.route === 'local' || options.forceLocal ? 'local' : 'cloud';
  if (route === 'local' && !isCodeFastLocal(options)) {
    throw new Error('Atris Code Fast local workspace requires AX_CODE_FAST_BACKEND_URL=http://127.0.0.1:8000; use --cloud for the public lane.');
  }

  const payload = buildCodeFastPayload(message, { ...options, route });
  const postData = JSON.stringify(payload);
  const output = options.output || process.stdout;
  const token = authToken();
  const timeoutMs = Math.max(10000, Math.min(600000, Number(payload.timeout_seconds || 180) * 1000));
  const turnUrl = new URL(codeFastUrl());
  const transport = turnUrl.protocol === 'https:' ? https : http;
  const state = {
    events: [],
    errors: [],
    output: '',
    pendingText: '',
    wroteText: false,
    wroteActivity: false,
    durationMs: 0,
    lastChar: '\n',
    progress: null,
    inAuxBlock: false,
    markdownMode: 'normal',
    markdownBuffer: '',
    markdownCarry: ''
  };

  return new Promise((resolve, reject) => {
    let settled = false;
    const startedAt = Date.now();
    state.progress = createProgressReporter(output, options);
    state.progress.start();

    const finish = (error, value) => {
      if (settled) return;
      settled = true;
      if (state.progress) state.progress.stop();
      state.progress = null;
      state.durationMs = Date.now() - startedAt;
      if (error) reject(error);
      else resolve(value);
    };

    const req = transport.request({
      hostname: turnUrl.hostname,
      port: turnUrl.port || (turnUrl.protocol === 'https:' ? 443 : 80),
      path: `${turnUrl.pathname}${turnUrl.search}`,
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Content-Length': Buffer.byteLength(postData),
        Accept: 'application/json',
        ...(token ? { Authorization: `Bearer ${token}` } : {})
      }
    }, (res) => {
      const chunks = [];
      res.on('data', chunk => chunks.push(chunk));
      res.on('end', () => {
        const rawBody = Buffer.concat(chunks).toString('utf8');
        let parsed = null;
        try {
          parsed = rawBody ? JSON.parse(rawBody) : null;
        } catch (_) {
          parsed = null;
        }

        if (res.statusCode < 200 || res.statusCode >= 300) {
          const detail = parsed && (parsed.detail || parsed.error || parsed.message);
          finish(new Error(detail || rawBody || `HTTP ${res.statusCode}`));
          return;
        }

        const text = String((parsed && (parsed.text || parsed.result || parsed.message)) || '').trim();
        if (text) {
          state.output = text;
          if (output && output.isTTY) output.write(renderTerminalMarkdown(text, output));
          else output.write(text);
          state.wroteText = true;
          state.wroteActivity = true;
          state.lastChar = text.slice(-1);
        }
        const notice = codeFastWorkspaceNotice(parsed);
        if (notice) {
          if (state.lastChar && state.lastChar !== '\n') output.write('\n');
          output.write(`${formatAuxRow('note', notice, output)}\n`);
          state.wroteActivity = true;
          state.lastChar = '\n';
        }
        state.events.push({ type: 'result', result: text, raw: parsed });
        state.billing = parsed && parsed.billing ? parsed.billing : null;
        if (parsed && parsed.duration_ms) state.durationMs = parsed.duration_ms;
        finish(null, state);
      });
    });

    req.on('error', finish);
    req.setTimeout(timeoutMs, () => {
      finish(new Error(`Request timeout after ${timeoutMs / 1000}s`));
      req.destroy();
    });
    req.write(postData);
    req.end();
  });
}

function turnFunctionForMode(mode) {
  return normalizeMode(mode) === 'code-fast' ? postCodeFastTurn : postTurn;
}

async function chat(options = {}) {
  const mode = normalizeMode(options.mode);
  const cwd = options.cwd || process.cwd();
  const input = options.input || process.stdin;
  const baseOutput = options.output || process.stdout;
  const logger = createRunLogger({ cwd, mode, kind: 'play', output: baseOutput });
  const output = logger ? logger.output : baseOutput;
  const history = [];

  output.write(`${formatHeader({ mode, cwd, chat: true })}\n\n`);
  if (logger) output.write(`${formatAuxRow('log', formatPathSubject(logger.path, output), output)}\n\n`);

  const runLine = async (line) => {
    const trimmed = String(line || '').trim();
    if (!trimmed) return false;
    if (EXIT_WORDS.has(trimmed.toLowerCase())) return true;

    if (logger) logger.write(`${formatPrompt(mode)}${trimmed}\n`);
    output.write('\n');
    const result = await turnFunctionForMode(mode)(trimmed, { mode, cwd, history, output, route: options.route });
    if (result.output && !result.output.endsWith('\n')) output.write('\n');
    output.write(`${formatDoneLine(result.durationMs)}\n\n`);
    history.push({ role: 'user', content: trimmed });
    history.push({ role: 'assistant', content: result.output || '' });
    return false;
  };

  if (!input.isTTY) {
    const rl = readline.createInterface({ input, crlfDelay: Infinity });
    for await (const line of rl) {
      if (await runLine(line)) break;
    }
    if (logger) logger.close(0);
    return;
  }

  const rl = readline.createInterface({ input, output: baseOutput });
  const ask = () => new Promise(resolve => rl.question(formatPrompt(mode), resolve));
  while (true) {
    const line = await ask();
    if (await runLine(line)) {
      rl.close();
      break;
    }
  }
  if (logger) logger.close(0);
}

