# Local files (not for public repo)
.local/
.atris/
.claude/

# Local scratch workspaces (created by `atris init` in subdirs for testing)
atris-labs-*/
atris/business/

# Dependencies
node_modules/

# Build outputs
dist/
build/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor directories
.vscode/
.idea/

# Environment variables
.env
.env.local

# Atris runtime files (user-specific, not for repo)
atris/logs/
atris/customers/
atris/.config
atris/.log_sync_state.json
atris/MAP.md
atris/TASK_CONTEXTS.md

# Feature documentation (user-specific work in progress)
# Track templates and README, ignore user-created features
atris/features/*
!atris/features/_templates/
!atris/features/README.md
!atris/features/endstate/
!atris/features/endstate/**
# Contract features: their validate.md rubrics are load-bearing; must travel with the code.
!atris/features/verify-falsifiability/
!atris/features/verify-falsifiability/**
!atris/features/plan-review-by-validator/
!atris/features/plan-review-by-validator/**
# Legacy location (deprecated)
docs/features/

# Research (competitive intel, scout reports)
atris/.research/

# Autopilot temp files
prd.json
progress.txt
.autopilot-prompt.tmp
.autopilot-horizons-prompt.tmp
