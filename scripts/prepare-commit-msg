#!/bin/sh

# atris co-author
if [ -d "$(git rev-parse --show-toplevel 2>/dev/null)/atris" ] && [ "$2" != "merge" ] && [ "$2" != "squash" ]; then
  if ! grep -qi "^co-authored-by: atris" "$1"; then
    printf '\nCo-authored-by: Atris <299057014+atris-builder[bot]@users.noreply.github.com>\n' >> "$1"
  fi
fi
