#!/bin/sh
#
# Pre-commit hook: block changes to lib/reward-config.js unless
# ATRIS_REWARD_EDIT=1 is set. Keeps the reward judge immutable
# during normal plan/do/review loops.

if [ "$ATRIS_REWARD_EDIT" = "1" ]; then
  exit 0
fi

if git diff --cached --name-only | grep -q '^lib/reward-config\.js$'; then
  echo "error: lib/reward-config.js is protected."
  echo "set ATRIS_REWARD_EDIT=1 to override."
  exit 1
fi

if git diff --cached --name-only --diff-filter=AM | grep -q '^atris/wiki/'; then
  echo "error: atris/wiki/ is local-only workspace memory and must not be committed."
  echo "each workspace creates their own wiki via atris init / atris ingest."
  exit 1
fi

# Load check: staged modules must load and their destructured imports must
# exist. Catches the silent partial-land failure (destructuring a missing
# export is undefined, not an error) that broke master on 2026-07-02.
node "$(git rev-parse --show-toplevel)/scripts/precommit-load-check.js" || exit 1
