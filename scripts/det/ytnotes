#!/bin/bash
# ytnotes <youtube-url> [engine]: local YouTube notes, tweet-feed one-screen.
# Zero Atris credits. yt-dlp pulls captions, a fast engine writes the notes.
# No captions: if mlx_whisper is installed (uv tool install mlx-whisper, Apple
# silicon), the audio is transcribed on this machine instead. Otherwise the
# script prints the paid command. ATRIS_YTNOTES_LOCAL_TRANSCRIBE=0 turns it off.
# Engines: auto (default: the team's notes writer from the roster, then the
# fastest installed writer that answers: Gemini Flash through agy, then Haiku,
# Codex, Cursor),
# gemini, haiku, atris-fast, grok, codex, cursor. ATRIS_YTNOTES_ENGINE sets the default.
# Outputs: $WORK/yt_${ID}.clean.txt (transcript), $WORK/yt_${ID}.md (notes).
set -euo pipefail

USAGE="usage: ytnotes <youtube-url> [auto|gemini|haiku|atris-fast|grok|codex|cursor]"

case "${1:-}" in
  *youtube.com*|*youtu.be*|*youtube-nocookie.com*) ;;
  *) echo "$USAGE" >&2; exit 2 ;;
esac

URL="$1"
ENGINE="${2:-${ATRIS_YTNOTES_ENGINE:-auto}}"
CALLER_CWD="$PWD"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
WORK="${TMPDIR:-/tmp}/ytnotes"
# uv tool installs (yt-dlp, mlx_whisper) live here; appended so it never
# shadows anything already on PATH.
PATH="$PATH:$HOME/.local/bin"
WHISPER_MODEL="${ATRIS_YTNOTES_WHISPER_MODEL:-mlx-community/whisper-large-v3-turbo}"
mkdir -p "$WORK"
cd "$WORK"

run_with_timeout() {
  local seconds="$1"
  shift
  perl -e '$seconds = shift @ARGV; alarm $seconds; exec @ARGV or do { print STDERR "$ARGV[0]: not installed\n"; exit 127 }' "$seconds" "$@"
}

# The Antigravity editor ships its own `agy` (a VS Code-style launcher script).
# It has no -p mode: it hands -p and --model to Electron and prints nothing, so
# it is not a writer. Only the Antigravity CLI is.
agy_is_cli() {
  local bin
  bin=$(command -v agy 2>/dev/null) || return 1
  ! head -c 4096 "$bin" 2>/dev/null | grep -q 'VSCODE_IPC_HOOK_CLI'
}

# An agy that is not signed in opens a Google login and waits up to 60s, which
# also pops the Antigravity app. `agy models` fails fast with "Please sign in"
# and opens nothing, so probe with it. Only that message counts as signed out:
# any other result (including a slow or odd probe) lets the writer run.
# The probe takes about 2s, so it starts in the background before the captions
# download and agy_signed_in reads its answer once the writer needs it.
agy_signed_in() {
  local out
  if [ -n "${AGY_PROBE_PID:-}" ]; then
    # The writer runs in a pipeline subshell, where wait cannot see this pid.
    while kill -0 "$AGY_PROBE_PID" 2>/dev/null; do sleep 0.05; done
    AGY_PROBE_PID=""
    AGY_PROBE_OUT=$(cat "$WORK/agy_probe.$$" 2>/dev/null) || true
  fi
  if [ -n "${AGY_PROBE_OUT+set}" ]; then
    out="$AGY_PROBE_OUT"
  else
    out=$(run_with_timeout 10 agy models </dev/null 2>&1) || true
  fi
  ! printf '%s' "$out" | grep -qi 'sign in'
}

# Fastest installed writer that answers: Gemini, Haiku, Codex, Cursor.
# Entries are cmd|model|effort|label; an empty model or effort means the default.
# Buffered so a failed or empty answer never reaches the notes file.
AUTO_WRITERS="agy|||Gemini claude|||Haiku codex|||Codex cursor-agent|||Cursor"

# The team's "notes" writer, from `atris engine resolve notes --json`, run from
# the caller's project with this same package. It only reorders: any failure,
# a slow answer (2s), or a writer that is not installed falls back to the order
# above. ATRIS_YTNOTES_ROSTER=0 skips it.
resolve_roster_writers() {
  [ "${ATRIS_YTNOTES_ROSTER:-1}" = "0" ] && return 0
  local json=""
  if [ -n "${ATRIS_YTNOTES_RESOLVE_CMD:-}" ]; then
    json=$(cd "$CALLER_CWD" && run_with_timeout 2 sh -c "$ATRIS_YTNOTES_RESOLVE_CMD" 2>/dev/null) || return 0
  else
    [ -f "$SCRIPT_DIR/../../bin/atris.js" ] || return 0
    json=$(cd "$CALLER_CWD" && ATRIS_AUTO_UPDATE=off run_with_timeout 2 node "$SCRIPT_DIR/../../bin/atris.js" engine resolve notes --json 2>/dev/null) || return 0
  fi
  printf '%s' "$json" | node -e '
    const s = require("fs").readFileSync(0, "utf8");
    const d = JSON.parse(s.slice(s.indexOf("{"), s.lastIndexOf("}") + 1));
    const cmds = { agy: "agy", gemini: "agy", haiku: "claude", claude: "claude", codex: "codex", cursor: "cursor-agent", "cursor-agent": "cursor-agent" };
    const clean = (v) => (v == null ? "" : String(v).replace(/[^A-Za-z0-9._:\/-]/g, ""));
    const label = (cmd, model) => ({ agy: "Gemini", codex: "Codex", "cursor-agent": "Cursor" }[cmd]
      || (/haiku/i.test(model || "haiku") ? "Haiku" : "Claude"));
    const out = [];
    for (const w of [d, ...(Array.isArray(d.backup) ? d.backup : [])]) {
      const cmd = cmds[String((w && w.engine) || "").toLowerCase()];
      if (!cmd) continue;
      const model = clean(w.model);
      out.push([cmd, model, clean(w.effort), label(cmd, model)].join("|"));
    }
    process.stdout.write(out.join(" "));
  ' 2>/dev/null || true
}

# Roster writers first, then the rest of the built-in order, one entry per cmd.
writer_list() {
  local entry cmd seen=" " list=""
  for entry in $(resolve_roster_writers) $AUTO_WRITERS; do
    cmd="${entry%%|*}"
    case "$seen" in *" $cmd "*) continue ;; esac
    seen="$seen$cmd "
    list="$list $entry"
  done
  printf '%s' "$list"
}

# Gemini spends about 3s on account and model lookups before it reads a prompt.
# When Gemini leads the writer list and the sign-in probe passes, start it now
# with streamed input so that startup overlaps the caption download; the writer
# sends the prompt once the transcript is ready. It never launches before the
# probe says signed in, so a signed-out agy cannot pop a login. The .pid file
# holds "<pid> <model> <effort>", or "none" when Gemini was not started.
AGY_WARM="$WORK/agy_warm.$$"
start_warm_gemini() {
  local lead="agy|||" model effort probe
  if [ "$ENGINE" = auto ]; then
    lead=$(writer_list)
    # Saved for run_auto: the lookup is a node start (about 0.2s) that would
    # otherwise run again after the captions land, before any writer starts.
    printf '%s' "$lead" > "$AGY_WARM.writers.tmp" && mv "$AGY_WARM.writers.tmp" "$AGY_WARM.writers"
    lead="${lead# }"
    lead="${lead%% *}"
  fi
  case "$lead" in agy\|*) ;; *) echo none > "$AGY_WARM.pid"; return 0 ;; esac
  IFS='|' read -r _ model effort _ <<< "$lead"
  # Only a signed-in agy prints its model list (id, tab, name), about 0.4s
  # before the probe exits, so start on the first model line.
  while kill -0 "$AGY_PROBE_PID" 2>/dev/null; do
    grep -q $'^[A-Za-z0-9._-]*\t' "$WORK/agy_probe.$$" 2>/dev/null && break
    sleep 0.05
  done
  probe=$(cat "$WORK/agy_probe.$$" 2>/dev/null) || probe="sign in"
  if printf '%s' "$probe" | grep -qi 'sign in'; then echo none > "$AGY_WARM.pid"; return 0; fi
  model="${ATRIS_YTNOTES_GEMINI_MODEL:-${model:-gemini-3.8-flash}}"
  effort="${effort:-low}"
  { while [ ! -e "$AGY_WARM.msg" ] && kill -0 $$ 2>/dev/null; do sleep 0.05; done
    cat "$AGY_WARM.msg" 2>/dev/null || true; } |
    perl -e 'alarm 120; exec @ARGV' agy --model "$model" --effort "$effort" --print-timeout 110s \
      --input-format stream-json --output-format stream-json -p "" >"$AGY_WARM.out" 2>/dev/null &
  echo "$! $model $effort" > "$AGY_WARM.pid.tmp"
  mv "$AGY_WARM.pid.tmp" "$AGY_WARM.pid"
}

stop_agy() {
  local pid=""
  kill "${AGY_PROBE_PID:-}" "${AGY_LAUNCHER_PID:-}" 2>/dev/null || true
  read -r pid _ < "$AGY_WARM.pid" 2>/dev/null || true
  case "$pid" in ''|none) ;; *) kill "$pid" 2>/dev/null || true ;; esac
  rm -f "$WORK/agy_probe.$$" "$AGY_WARM".*
}

# A quota error from Gemini is remembered until its reset (at most 3 hours), so
# auto mode skips the probe and the early Gemini while the quota is used up.
GEMINI_QUOTA="$WORK/gemini_quota_until"
gemini_quota_wall() {
  local until
  # Most runs have no quota memory; a missing file must not print an error.
  [ -r "$GEMINI_QUOTA" ] || return 1
  read -r until < "$GEMINI_QUOTA" || return 1
  case "$until" in ''|*[!0-9]*) return 1 ;; esac
  [ "$(date +%s)" -lt "$until" ]
}

case "$ENGINE" in
  auto|gemini|agy)
    if [ "$ENGINE" = auto ] && gemini_quota_wall; then
      :
    elif agy_is_cli; then
      run_with_timeout 10 agy models </dev/null >"$WORK/agy_probe.$$" 2>&1 &
      AGY_PROBE_PID=$!
      start_warm_gemini &
      AGY_LAUNCHER_PID=$!
      trap stop_agy EXIT
    fi
    ;;
esac

# Printed metadata and a written English VTT are a hit even when yt-dlp exits 429.
# A leaked WARNING|ERROR print line is not the video id.
# Manual English is --write-subs. Auto English is often en-orig / en-US / en-GB.
# Plain auto "en" is YouTube's machine translation and returns HTTP 429, which
# made yt-dlp quit before writing en-orig. Ask for en-orig first, keep going.
# Teach parses leftover yt_<id>.clean.txt stamps as cues.
# Empty --print still keeps a VTT written in this run (id from the watch /
# shorts / embed / live / e / nocookie embed URL or the new filename). A copied
# #t= timestamp is stripped so leftover yt_<id> files still match. When VTT is
# gone, leftover yt_<id>.clean.txt from a prior notes run is still a keep.
# Another video's leftover clean.txt is not invent-keep.
if ! command -v yt-dlp >/dev/null 2>&1; then
  echo "This computer is missing yt-dlp, the free tool that reads YouTube captions." >&2
  echo "Install it, then run the same command again:" >&2
  echo "  Mac: brew install yt-dlp    Any computer: pipx install yt-dlp" >&2
  exit 2
fi

# YouTube blocks old yt-dlp copies, and the failure looks like "no captions".
# The version check runs beside the caption fetch (0.2s warm, 1.7s cold) and
# is read once the fetch is done.
yt-dlp --version >"yt_version.$$.out" 2>/dev/null &
YTDLP_VERSION_PID=$!

existing=""
for name in yt_*.en-orig.vtt yt_*.en.vtt yt_*.en-US.vtt yt_*.en-GB.vtt; do
  [ -e "$name" ] || continue
  existing="$existing $name"
done

# Captions never need the stream lists, so skip fetching them (about 0.2s).
# They never need the player script either: it only unlocks the video streams,
# and solving it in deno took about 1.1s. The caption files come out the same.
# A live video may have no other streams; keep going so its captions still land.
fetch_captions() {
  yt-dlp --no-update --quiet --no-warnings --skip-download \
    --write-subs --write-auto-subs --sub-format vtt --sub-langs "en-orig,en,en-US,en-GB" --ignore-errors \
    --extractor-args "$1" --ignore-no-formats-error \
    --no-simulate \
    -o "yt_%(id)s" \
    --print "%(id)s|%(title)s|%(channel)s|%(duration_string)s" \
    "$URL" >"yt_meta.$$.out" 2>>"yt_captions.$$.err" </dev/null &
  CAPTIONS_PID=$!
  # The notes read the original English track first. Once it is whole, stop
  # yt-dlp before it asks for the auto "en" copy, which took about 0.5s and
  # usually ends in a 429. yt-dlp prints the id line just before it writes
  # captions, and renames a track's .part file only when the track is whole.
  while kill -0 "$CAPTIONS_PID" 2>/dev/null; do
    cid=$(sed -n 's/^\([A-Za-z0-9_-]\{1,\}\)|.*/\1/p' "yt_meta.$$.out" 2>/dev/null | tail -n 1)
    if [ -n "$cid" ] && [ -s "yt_${cid}.en-orig.vtt" ] && [ ! -e "yt_${cid}.en-orig.vtt.part" ]; then
      # A quiet wait ends the moment yt-dlp does, with no "Terminated" line.
      kill "$CAPTIONS_PID" 2>/dev/null || true
      wait "$CAPTIONS_PID" 2>/dev/null || true
      rm -f "yt_${cid}".*.part
      break
    fi
    sleep 0.05
  done
  wait "$CAPTIONS_PID" 2>/dev/null || true
}
captions_landed() {
  local cid name
  cid=$(sed -n 's/^\([A-Za-z0-9_-]\{1,\}\)|.*/\1/p' "yt_meta.$$.out" 2>/dev/null | tail -n 1)
  [ -n "$cid" ] || return 1
  for name in "yt_${cid}.en-orig.vtt" "yt_${cid}.en.vtt" "yt_${cid}.en-US.vtt" "yt_${cid}.en-GB.vtt"; do
    [ -s "$name" ] && return 0
  done
  return 1
}
# The iOS client skips the webpage too (about 1s) and still lists captions;
# the others list none without it. Its file drops the word timing tags, but
# the cleaned words come out the same. When it lands no English captions,
# fetch again the full way, so a missing iOS track never reads as no captions.
: > "yt_captions.$$.err"
fetch_captions "youtube:skip=hls,dash;player_skip=js,webpage;player_client=ios"
captions_landed || fetch_captions "youtube:skip=hls,dash;player_skip=js"
META=$(cat "yt_meta.$$.out" 2>/dev/null) || true
rm -f "yt_meta.$$.out"
# A sign-in wall on the caption fetch is a blocked connection, not a video
# without captions. A bare 429 is not: the auto "en" track 429s on its own.
CAPTIONS_BLOCKED=0
grep -qiE "not a bot|sign in to confirm" "yt_captions.$$.err" 2>/dev/null && CAPTIONS_BLOCKED=1
rm -f "yt_captions.$$.err"
# Warn when the version date (YYYY.MM.DD, maybe .N) is too old; keep going.
# A version that does not parse stays silent.
wait "$YTDLP_VERSION_PID" 2>/dev/null || true
YTDLP_VERSION=$(cat "yt_version.$$.out" 2>/dev/null) || true
rm -f "yt_version.$$.out"
YTDLP_AGE=$(perl -MTime::Local -e '
  my ($v, $max) = @ARGV;
  exit 0 unless $max =~ /\A\d+\z/;
  my ($y, $m, $d) = $v =~ /\A\s*(\d{4})\.(\d{1,2})\.(\d{1,2})(?:\.\d+)?\s*\z/ or exit 0;
  my $t = eval { timelocal(0, 0, 12, $d, $m - 1, $y) };
  exit 0 unless defined $t;
  my $age = int((time - $t) / 86400);
  print $age if $age > $max;
' "$YTDLP_VERSION" "${ATRIS_YTNOTES_YTDLP_MAX_AGE_DAYS:-60}" 2>/dev/null) || true
if [ -n "$YTDLP_AGE" ]; then
  echo "Your yt-dlp is $YTDLP_AGE days old, and YouTube often blocks old copies. Update it: brew upgrade yt-dlp (Mac) or pipx upgrade yt-dlp" >&2
fi
# Skip WARNING/ERROR/INFO print leaks and NA/None sentinels. Keep the last
# id|title line so notes stay on yt_<id>.md and keep can find them after a
# later error. Same sentinel bar as watch/search looksLikeFlatVideoId.
ID=""
INFO=""
while IFS= read -r line || [ -n "$line" ]; do
  trimmed="${line#"${line%%[![:space:]]*}"}"
  case "$trimmed" in
    WARNING*|ERROR*|INFO*|warning*|error*|info*) continue ;;
  esac
  case "$trimmed" in
    *'|'*)
      cand="${trimmed%%|*}"
      folded=$(printf '%s' "$cand" | tr '[:upper:]' '[:lower:]')
      case "$folded" in
        ''|na|none) continue ;;
      esac
      case "$cand" in
        *[!A-Za-z0-9_-]*) continue ;;
      esac
      ID="$cand"
      INFO="${trimmed#*|}"
      ;;
  esac
done <<EOF
$META
EOF
if [ -z "$ID" ]; then
  case "$URL" in
    *'?v='*|*'&v='*)
      ID="${URL#*'?v='}"
      if [ "$ID" = "$URL" ]; then
        ID="${URL#*'&v='}"
      fi
      ID="${ID%%&*}"
      ID="${ID%%\?*}"
      ;;
    *'youtu.be/'*)
      ID="${URL#*'youtu.be/'}"
      ID="${ID%%\?*}"
      ID="${ID%%&*}"
      ID="${ID%%/*}"
      ;;
    *'/shorts/'*)
      ID="${URL#*'/shorts/'}"
      ID="${ID%%\?*}"
      ID="${ID%%&*}"
      ID="${ID%%/*}"
      ;;
    *'/embed/'*)
      ID="${URL#*'/embed/'}"
      ID="${ID%%\?*}"
      ID="${ID%%&*}"
      ID="${ID%%/*}"
      ;;
    *'/e/'*)
      ID="${URL#*'/e/'}"
      ID="${ID%%\?*}"
      ID="${ID%%&*}"
      ID="${ID%%/*}"
      ;;
    *'/live/'*)
      ID="${URL#*'/live/'}"
      ID="${ID%%\?*}"
      ID="${ID%%&*}"
      ID="${ID%%/*}"
      ;;
  esac
  ID="${ID%%#*}"
fi

VTT=""
if [ -n "$ID" ]; then
  for name in "yt_${ID}.en-orig.vtt" "yt_${ID}.en.vtt" "yt_${ID}.en-US.vtt" "yt_${ID}.en-GB.vtt" "yt_${ID}.local.vtt"; do
    if [ -s "$name" ]; then
      VTT="$name"
      break
    fi
  done
fi
if [ -z "$VTT" ]; then
  for name in yt_*.en-orig.vtt yt_*.en.vtt yt_*.en-US.vtt yt_*.en-GB.vtt; do
    [ -s "$name" ] || continue
    case " $existing " in
      *" $name "*) continue ;;
    esac
    VTT="$name"
    if [ -z "$ID" ]; then
      ID="${name#yt_}"
      ID="${ID%%.*}"
    fi
    break
  done
fi
# No captions: transcribe the audio on this machine. Writes yt_<id>.local.vtt
# and deletes the audio. Returns non-zero, with the reason in LOCAL_FAIL, when
# the model is missing or a step fails.
LOCAL_FAIL=""
transcribe_locally() {
  if [ "${ATRIS_YTNOTES_LOCAL_TRANSCRIBE:-1}" = "0" ]; then
    LOCAL_FAIL="off"; return 1
  fi
  if ! command -v mlx_whisper >/dev/null 2>&1; then
    LOCAL_FAIL="no-model"; return 1
  fi
  echo "No captions on this video. Transcribing the audio on this computer (free, about 1 minute per 15 minutes of video)." >&2
  rm -f "yt_${ID}".audio.*
  # When YouTube flags a connection it answers "Sign in to confirm you're not
  # a bot" to the default player, but the embedded-player client still gets
  # audio. Try each client in ATRIS_YTNOTES_AUDIO_CLIENTS in order ("default"
  # = yt-dlp's own pick). A bot answer moves to the next client at once.
  # YouTube also refuses some media requests at random (HTTP 403) and allows
  # the next one, so each client gets three tries for any other error.
  # Browser cookies are opt-in only: ATRIS_YTNOTES_COOKIES_FROM_BROWSER=safari.
  local cookie_args=()
  if [ -n "${ATRIS_YTNOTES_COOKIES_FROM_BROWSER:-}" ]; then
    cookie_args=(--cookies-from-browser "$ATRIS_YTNOTES_COOKIES_FROM_BROWSER")
  fi
  local client attempt downloaded=0 blocked=1
  for client in ${ATRIS_YTNOTES_AUDIO_CLIENTS:-web_embedded default}; do
    local client_args=()
    [ "$client" = default ] || client_args=(--extractor-args "youtube:player_client=$client")
    for attempt in 1 2 3; do
      # ${a[@]+...} keeps empty arrays safe under set -u in macOS bash 3.2.
      if yt-dlp --no-update --quiet --no-warnings --no-playlist \
          ${client_args[@]+"${client_args[@]}"} ${cookie_args[@]+"${cookie_args[@]}"} \
          -f "bestaudio[ext=m4a]/bestaudio/best" -o "yt_${ID}.audio.%(ext)s" "$URL" 2>"yt_${ID}.audio.err"; then
        downloaded=1; break 2
      fi
      if grep -qiE "not a bot|sign in to confirm" "yt_${ID}.audio.err" 2>/dev/null; then
        break
      fi
      blocked=0
      [ "$attempt" = 3 ] || sleep "$((attempt * ${ATRIS_YTNOTES_RETRY_SECONDS:-3}))"
    done
  done
  if [ "$downloaded" != 1 ]; then
    if [ "$blocked" = 1 ] && grep -qiE "not a bot|sign in to confirm" "yt_${ID}.audio.err" 2>/dev/null; then
      LOCAL_FAIL="blocked"
    else
      LOCAL_FAIL="download: $(grep -m1 ERROR "yt_${ID}.audio.err" 2>/dev/null || echo "yt-dlp failed")"
    fi
    rm -f "yt_${ID}".audio.*
    return 1
  fi
  local audio=""
  for f in "yt_${ID}".audio.*; do
    case "$f" in *.err|*.part) continue ;; esac
    [ -s "$f" ] && audio="$f" && break
  done
  if [ -z "$audio" ]; then
    LOCAL_FAIL="download: no audio file"; rm -f "yt_${ID}".audio.*; return 1
  fi
  if ! mlx_whisper "$audio" --model "$WHISPER_MODEL" --output-format vtt \
      --output-dir "$WORK" --output-name "whisper_${ID}" --verbose False >"yt_${ID}.whisper.log" 2>&1; then
    LOCAL_FAIL="transcribe: $(tail -n 1 "yt_${ID}.whisper.log")"
    rm -f "yt_${ID}".audio.* "whisper_${ID}.vtt"
    return 1
  fi
  # mlx_whisper drops anything after a dot in --output-name, so write a
  # dot-free name and rename it.
  mv -f "whisper_${ID}.vtt" "yt_${ID}.local.vtt" 2>/dev/null || true
  rm -f "yt_${ID}".audio.* "yt_${ID}.whisper.log"
  [ -s "yt_${ID}.local.vtt" ] || { LOCAL_FAIL="transcribe: empty transcript"; return 1; }
}

if [ -z "$VTT" ]; then
  if [ -n "$ID" ] && [ -s "yt_${ID}.clean.txt" ]; then
    : # leftover cleaned transcript from a prior notes run
  elif [ "$CAPTIONS_BLOCKED" = 1 ]; then
    # The audio download would hit the same wall, so skip it.
    echo "YouTube is blocking caption downloads from this internet connection right now (it asks to sign in). Try again in a few hours or on another network." >&2
    echo "Paid notes, 5 credits, refunded if it fails: atris youtube process \"$URL\"" >&2
    exit 2
  elif [ -n "$ID" ] && transcribe_locally; then
    VTT="yt_${ID}.local.vtt"
  else
    echo "No English captions found for $URL." >&2
    case "$LOCAL_FAIL" in
      no-model) echo "This computer has no local speech model to transcribe it." >&2 ;;
      blocked) echo "YouTube is blocking audio downloads from this internet connection right now (it asks to sign in). Try again in a few hours or on another network, or opt in to your browser login: ATRIS_YTNOTES_COOKIES_FROM_BROWSER=safari" >&2 ;;
      download:*|transcribe:*) echo "Local transcription failed (${LOCAL_FAIL})." >&2 ;;
    esac
    echo "Paid notes, 5 credits, refunded if it fails: atris youtube process \"$URL\"" >&2
    exit 2
  fi
fi

# Strip VTT cruft, drop only nearby rolling-caption duplicates, and keep one
# time anchor every 30 seconds. Raw auto-captions are mostly timestamp spam:
# the 21-minute canary is 210 KB raw, 95 KB with the old cleaner, and 22 KB here.
# Leftover clean.txt is already cleaned; do not overwrite it with an empty VTT pass.
if [ -n "$VTT" ]; then
sed -E 's/<[^>]*>//g; s/&gt;/>/g; s/&amp;/\&/g; s/&quot;/"/g' "$VTT" | awk '
function seconds(ts, parts, n) {
  n = split(ts, parts, ":")
  if (n == 2) return (parts[1] * 60) + int(parts[2])
  return (parts[1] * 3600) + (parts[2] * 60) + int(parts[3])
}
BEGIN { last_bucket = -1 }
/^(WEBVTT|Kind:|Language:)/ { next }
/-->/ { cue_seconds = seconds($1); next }
{
  line = $0
  gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
  if (line == "") next

  duplicate = 0
  for (i = 0; i < 6; i++) if (recent[i] == line) duplicate = 1
  if (duplicate) next

  bucket = int(cue_seconds / 30)
  if (bucket != last_bucket) {
    total = int(cue_seconds)
    hours = int(total / 3600)
    minutes = int((total % 3600) / 60)
    secs = total % 60
    if (hours > 0) printf "[%02d:%02d:%02d]\n", hours, minutes, secs
    else printf "[%02d:%02d]\n", minutes, secs
    last_bucket = bucket
  }

  print line
  for (i = 5; i > 0; i--) recent[i] = recent[i - 1]
  recent[0] = line
}' > "yt_${ID}.clean.txt"
fi

TRANSCRIPT=$(<"yt_${ID}.clean.txt")

STYLE_PROMPT="Write one-screen tweet-feed notes on this YouTube transcript ($INFO). Markdown only, start with # title then a 'Channel · Duration' line, 6-8 beats each opening with a **Bold hook.**, 4-6 verbatim quotes, each on its own line shaped exactly > \"quote\" [mm:ss], end with a 2-item **Takeaway**. No preamble, no em dashes, fits one screen."

PROMPT="$STYLE_PROMPT

Transcript:
$TRANSCRIPT"

run_atris_fast() {
  if [ ! -d "$CALLER_CWD/atris" ]; then
    echo "atris-fast requires ytnotes to run from an initialized Atris workspace" >&2
    return 2
  fi

  local jobs_file="$WORK/yt_${ID}.jobs.json"
  local map_raw

  node - "$INFO" "$WORK/yt_${ID}.clean.txt" "$jobs_file" <<'NODE'
const fs = require('fs')
const info = process.argv[2]
const transcriptPath = process.argv[3]
const jobsPath = process.argv[4]
const lines = fs.readFileSync(transcriptPath, 'utf8').trim().split('\n')
const targetBytes = 11000
const chunks = []
let current = []
let bytes = 0

for (const line of lines) {
  const lineBytes = Buffer.byteLength(`${line}\n`)
  if (current.length && bytes + lineBytes > targetBytes) {
    chunks.push(current.join('\n'))
    current = []
    bytes = 0
  }
  current.push(line)
  bytes += lineBytes
}
if (current.length) chunks.push(current.join('\n'))

const jobs = chunks.map((chunk, index) => ({
  engine: 'atris-fast',
  label: `chunk-${String(index + 1).padStart(2, '0')}`,
  prompt: `Read-only transcript analysis. Do not call tools. This is ordered chunk ${index + 1} of ${chunks.length} from ${info}. Return only valid JSON with this exact shape: {"beats":[{"time":"mm:ss","hook":"max 8 words","detail":"max 18 words"}],"action":"max 14 words"}. Pick exactly 3 critical beats. Prefer concrete names, numbers, mechanisms, and honest uncertainty; paraphrase instead of quoting. No markdown or preamble.\n\n${chunk}`,
}))

fs.writeFileSync(jobsPath, JSON.stringify(jobs))
NODE

  map_raw=$(cd "$CALLER_CWD" && atris engine ask --jobs "$jobs_file" \
    --concurrency 3 --timeout 15 --json)
  printf '%s' "$map_raw" | node -e '
let raw = ""
process.stdin.on("data", (chunk) => { raw += chunk })
process.stdin.on("end", () => {
  // A refused run (too many chunks, too many bytes) prints its reason and no
  // receipt; fail as a writer instead of a stack trace.
  let receipt
  try { receipt = JSON.parse(raw) } catch { process.exit(2) }
  const answers = [...(receipt.answers || [])].sort((a, b) => a.label.localeCompare(b.label))
  if (!answers.length || answers.some((answer) => !answer.ok)) process.exit(2)

  const titleParts = process.argv[1].split("|")
  const beats = []
  const actions = []
  for (const answer of answers) {
    let output = answer.stdout
    try { output = JSON.parse(answer.stdout).output || output } catch {}
    const clean = String(output).trim().replace(/^```(?:json)?\s*/i, "").replace(/\s*```$/, "")
    let parsed
    try { parsed = JSON.parse(clean) } catch { process.exit(2) }
    for (const beat of (parsed.beats || []).slice(0, 3)) beats.push(beat)
    if (parsed.action) actions.push(String(parsed.action))
  }
  if (beats.length < 4) process.exit(2)

  const lines = [`# ${titleParts[0]}`, `${titleParts[1] || "YouTube"} · ${titleParts[2] || ""}`]
  for (const beat of beats.slice(0, 6)) {
    const hook = String(beat.hook || "Key idea").replace(/[.]+$/, "")
    const time = String(beat.time || "").replace(/^\[|\]$/g, "")
    lines.push("", `**${hook}.**`, `${String(beat.detail || "").trim()}${time ? ` [${time}]` : ""}`)
  }
  lines.push("", "**Takeaway**", "", `1. ${actions[0] || "Apply the strongest mechanism to one current Atris mission."}`, `2. ${actions[1] || "Require one proof artifact before that mission advances."}`)
  process.stdout.write(`${lines.join("\n").trim()}\n`)
})' "$INFO"
}

run_grok() {
  run_with_timeout 240 grok --verbatim --no-memory --no-plan --no-subagents \
    --disable-web-search --max-turns 3 -p "$PROMPT"
}

# Notes need no tools, MCP servers, hooks, skills, or a saved session. Skipping
# them takes about 5s off a 21-minute video (19s to 15s) and keeps the stored
# login, unlike --bare. Under an agent or a pipe that never closes, claude
# waits 3s for stdin before it starts; </dev/null skips that wait. Skipping
# the update check and telemetry calls takes startup from about 2.8s to 2.0s.
# Low effort took Haiku from about 15.7s to 12.7s on a 21-minute video (four
# paired runs, quotes still checked), so low is the default, like Gemini's.
run_haiku() {
  CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
  run_with_timeout 240 claude -p "$PROMPT" --model "${1:-claude-haiku-5-5}" \
    --effort "${2:-low}" --tools "" --strict-mcp-config --setting-sources "" \
    --no-session-persistence --disable-slash-commands </dev/null
}

# Gemini Flash through the Antigravity CLI (agy). On an 85-minute transcript it
# writes notes in about 8s; Haiku takes 30-40s. The old gemini CLI is retired.
# Low effort is the floor for notes: high effort is slower and not sharper here.
# Auto mode probes agy before it gets here; AGY_READY=1 skips a second 2-3s probe.
run_gemini() {
  if [ "${AGY_READY:-}" != 1 ]; then
    command -v agy >/dev/null 2>&1 || { echo "agy is not installed" >&2; return 127; }
    agy_is_cli || { echo "agy on PATH is the Antigravity editor launcher, which has no -p mode. Install the Antigravity CLI for Gemini notes." >&2; return 127; }
    agy_signed_in || { echo "agy is installed but not signed in. Run: agy (sign in once) for Gemini notes." >&2; return 127; }
  fi
  local warm=0
  warm_gemini "${ATRIS_YTNOTES_GEMINI_MODEL:-${1:-gemini-3.8-flash}}" "${2:-low}" && return 0 || warm=$?
  # A used-up Gemini quota refuses a second request the same way, so skip it.
  if [ "$warm" = 2 ]; then echo "Gemini quota reached; not sending a second Gemini request." >&2; return 1; fi
  run_with_timeout 120 agy -p "$PROMPT" --model "${ATRIS_YTNOTES_GEMINI_MODEL:-${1:-gemini-3.8-flash}}" \
    --effort "${2:-low}" --print-timeout 110s </dev/null
}

# Send the prompt to the Gemini started early, if it runs the same model and
# effort. Any miss (not started, other model, error, empty answer) returns 1
# and run_gemini starts Gemini the normal way. A quota error returns 2.
warm_gemini() {
  local pid model effort
  [ -n "${AGY_LAUNCHER_PID:-}" ] || return 1
  while [ ! -e "$AGY_WARM.pid" ] && kill -0 "$AGY_LAUNCHER_PID" 2>/dev/null; do sleep 0.05; done
  read -r pid model effort < "$AGY_WARM.pid" 2>/dev/null || return 1
  [ "$pid" != none ] && [ "$model" = "$1" ] && [ "$effort" = "$2" ] || return 1
  printf '%s' "$PROMPT" | node -e '
    const content = require("fs").readFileSync(0, "utf8");
    process.stdout.write(JSON.stringify({ event: "user", message: { role: "user", content } }) + "\n");
  ' > "$AGY_WARM.msg.tmp" && mv "$AGY_WARM.msg.tmp" "$AGY_WARM.msg" || return 1
  # The answer is whole once its result line ends; agy takes about 0.3s more to
  # exit, and stop_agy ends it when the script finishes.
  while kill -0 "$pid" 2>/dev/null; do
    grep -q '^{"event":"result".*}$' "$AGY_WARM.out" 2>/dev/null && [ -z "$(tail -c 1 "$AGY_WARM.out")" ] && break
    sleep 0.05
  done
  node -e '
    const lines = require("fs").readFileSync(process.argv[1], "utf8").split("\n");
    for (const line of lines.reverse()) {
      let ev;
      try { ev = JSON.parse(line); } catch { continue; }
      if (ev.event !== "result") continue;
      const r = ev.result || {};
      if (r.status === "ERROR" && /quota/i.test(r.error || "")) {
        const m = /Resets in (?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?/.exec(r.error) || [];
        const wait = (+m[1] || 0) * 3600 + (+m[2] || 0) * 60 + (+m[3] || 0) || 3600;
        require("fs").writeFileSync(process.argv[2], String(Math.floor(Date.now() / 1000) + Math.min(wait, 10800)) + "\n");
        process.exit(2);
      }
      if (r.status === "ERROR" || !/[A-Za-z0-9]/.test(r.response || "")) process.exit(1);
      process.stdout.write(r.response);
      process.exit(0);
    }
    process.exit(1);
  ' "$AGY_WARM.out" "$GEMINI_QUOTA" 2>/dev/null
}

run_writer() {
  local model="${2:-}"
  case "$1" in
    agy) AGY_READY=1 run_gemini "$model" "${3:-}" ;;
    claude) run_haiku "$model" "${3:-}" ;;
    codex) run_with_timeout 240 codex exec ${model:+-m "$model"} --sandbox read-only --skip-git-repo-check "$PROMPT" </dev/null ;;
    cursor-agent) run_with_timeout 240 cursor-agent --trust ${model:+--model "$model"} -p "$PROMPT" ;;
  esac
}

# Start a writer in the background: its answer lands in $2, its exit code in $2.rc.
start_writer() {
  local cmd model effort
  IFS='|' read -r cmd model effort _ <<< "$1"
  # Gemini's sign-in probe is read here, so waiting on it overlaps the head start.
  { rc=0
    if [ "$cmd" = agy ] && ! agy_signed_in; then rc=99; else run_writer "$cmd" "$model" "$effort" || rc=$?; fi
    echo "$rc" > "$2.rc.tmp"; mv "$2.rc.tmp" "$2.rc"; } >"$2" 2>>"$WORK/yt_${ID}.engine.err" </dev/null &
  WRITER_PID=$!
}

# Notes open with a # title. A refusal has none, so it never wins the race.
writer_ok() { [ "$(cat "$1.rc" 2>/dev/null)" = 0 ] && grep -q '^#' "$1"; }

# disown first, or the shell prints "Terminated" and the whole writer block on screen.
stop_writer() { disown "$1" 2>/dev/null || true; pkill -P "$1" 2>/dev/null || true; kill "$1" 2>/dev/null || true; }

# A used-up Gemini quota answers about 3s after the captions are ready, and the
# backup only started after that. Now both start together (no head start) and
# the first good answer wins; Gemini wins a tie. Gemini takes about 5s from the
# prompt, so a 1s head start only delayed Haiku: 8 paired runs, 7.80s vs 8.47s.
# ATRIS_YTNOTES_HEDGE_SECS=off waits for Gemini first, as before. Returns 1 when
# Gemini failed before the backup started, or with RACE_FAILED set when both failed.
HEDGE_SECS="${ATRIS_YTNOTES_HEDGE_SECS:-0}"
race_writers() {
  local a="$WORK/race.$$.a" b="$WORK/race.$$.b" apid bpid="" tpid blabel="${2##*|}" win=""
  rm -f "$a" "$a.rc" "$b" "$b.rc" "$b.go"
  start_writer "$1" "$a"; apid=$WRITER_PID
  # A real timer: counting 0.05s polls stretched a 1s head start to about 2s.
  { sleep "$HEDGE_SECS"; : > "$b.go"; } </dev/null >/dev/null 2>&1 &
  tpid=$!
  while [ -z "$win" ]; do
    if [ -e "$a.rc" ]; then
      if writer_ok "$a"; then win=a; break; fi
      if [ "$(cat "$a.rc")" = 99 ]; then
        echo "agy is installed but not signed in; skipping Gemini. Run: agy (sign in once)." >&2
        RACE_SIGNED_OUT=1
      fi
      if [ -z "$bpid" ]; then win=none; break; fi
      [ -n "${RACE_SIGNED_OUT:-}" ] || echo "${1##*|} did not answer; writing the notes with $blabel instead." >&2
      while [ ! -e "$b.rc" ]; do sleep 0.05; done
      if writer_ok "$b"; then win=b; else win=none; RACE_FAILED="${2%%|*}"; fi
      break
    fi
    if [ -n "$bpid" ] && writer_ok "$b"; then stop_writer "$apid"; win=b; break; fi
    if [ -z "$bpid" ] && [ -e "$b.go" ]; then start_writer "$2" "$b"; bpid=$WRITER_PID; fi
    sleep 0.05
  done
  disown "$tpid" 2>/dev/null || true; kill "$tpid" 2>/dev/null || true
  case "$win" in
    a) [ -z "$bpid" ] || stop_writer "$bpid"; cat "$a"; echo "notes by ${1##*|}" >&2 ;;
    b) cat "$b"; echo "notes by $blabel" >&2 ;;
  esac
  rm -f "$a" "$a.rc" "$b" "$b.rc" "$b.go"
  [ "$win" != none ]
}

run_auto() {
  local entry cmd model effort label out tried="" list backup="" skip=" "
  list=$(cat "$AGY_WARM.writers" 2>/dev/null) || true
  [ -n "$list" ] || list=$(writer_list)
  for entry in $list; do
    case "$entry" in agy\|*) continue ;; esac
    command -v "${entry%%|*}" >/dev/null 2>&1 && { backup="$entry"; break; }
  done
  for entry in $list; do
    IFS='|' read -r cmd model effort label <<< "$entry"
    case "$skip" in *" $cmd "*) continue ;; esac
    command -v "$cmd" >/dev/null 2>&1 || continue
    if [ "$cmd" = agy ] && gemini_quota_wall; then
      echo "Gemini's quota was used up on a recent run; skipping Gemini until it resets." >&2
      continue
    fi
    if [ "$cmd" = agy ] && ! agy_is_cli; then continue; fi
    if [ "$cmd" = agy ] && [ -z "$tried" ] && [ -n "$backup" ] && [ "$HEDGE_SECS" != off ]; then
      RACE_FAILED=""; RACE_SIGNED_OUT=""
      race_writers "$entry" "$backup" && return 0
      [ -n "$RACE_SIGNED_OUT" ] || tried="$label"
      if [ -n "$RACE_FAILED" ]; then skip="$skip$RACE_FAILED "; tried="${backup##*|}"; fi
      continue
    fi
    if [ "$cmd" = agy ] && ! agy_signed_in; then
      echo "agy is installed but not signed in; skipping Gemini. Run: agy (sign in once)." >&2
      continue
    fi
    if [ -n "$tried" ]; then
      echo "$tried did not answer; writing the notes with $label instead." >&2
    fi
    if out=$(run_writer "$cmd" "$model" "$effort" 2>>"$WORK/yt_${ID}.engine.err") && printf '%s' "$out" | grep -q '^#'; then
      printf '%s\n' "$out"
      echo "notes by $label" >&2
      return 0
    fi
    tried="$label"
  done
  if [ -n "$tried" ]; then
    echo "$tried did not answer, and no other AI writer is installed." >&2
  else
    echo "No AI writer is installed on this computer. Install one of: Claude Code (claude), Antigravity (agy), Codex (codex), Cursor (cursor-agent)." >&2
  fi
  return 3
}

{
  case "$ENGINE" in
    auto)
      run_auto
      ;;
    haiku)
      run_haiku
      ;;
    atris-fast|fast|atris)
      run_atris_fast
      ;;
    gemini|agy)
      run_gemini
      ;;
    grok)   run_grok ;;
    codex)  run_writer codex ;;
    cursor) run_writer cursor-agent ;;
    *) echo "unknown engine: $ENGINE (auto|gemini|haiku|atris-fast|grok|codex|cursor)" >&2; exit 1 ;;
  esac
} | perl -0pe 's/\A.*?(?=# )//s' > "yt_${ID}.md" || true

if ! grep -q '[[:alnum:]]' "yt_${ID}.md"; then
  rm -f "yt_${ID}.md"
  echo "No notes were written. The transcript is saved at $WORK/yt_${ID}.clean.txt" >&2
  echo "Paid notes, 5 credits, refunded if it fails: atris youtube process \"$URL\"" >&2
  exit 3
fi
# auto names its writer above; a pinned engine is named here.
[ "$ENGINE" = "auto" ] || echo "notes by $ENGINE" >&2
cat "yt_${ID}.md"

node "$SCRIPT_DIR/ytquote-repair.js" "yt_${ID}.md" "yt_${ID}.clean.txt"
