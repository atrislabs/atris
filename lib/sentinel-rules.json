{
  "version": 1,
  "guard": {
    "allow_hosts": [
      "localhost",
      "127.0.0.1",
      "0.0.0.0",
      "::1",
      "api.github.com",
      "github.com",
      "uploads.github.com",
      "api.openai.com",
      "api.anthropic.com",
      "registry.npmjs.org",
      "pypi.org",
      "upload.pypi.org",
      "api.atris.ai",
      "atris.ai",
      "api.stripe.com",
      "slack.com",
      "api.vercel.com",
      "api.render.com"
    ],
    "net_tools": [
      "curl",
      "wget",
      "nc",
      "ncat",
      "netcat",
      "socat",
      "telnet",
      "scp",
      "sftp",
      "ftp",
      "rsync",
      "http",
      "https",
      "xh",
      "httpie",
      "aria2c",
      "lftp",
      "ssh"
    ],
    "secret_parts": [
      "KEY",
      "KEYS",
      "TOKEN",
      "TOKENS",
      "SECRET",
      "SECRETS",
      "PASSWORD",
      "PASSWD",
      "PASS",
      "PWD",
      "CREDENTIAL",
      "CREDENTIALS",
      "CREDS",
      "AUTH",
      "PRIVATE",
      "SESSION",
      "COOKIE",
      "APIKEY",
      "PAT",
      "DSN"
    ],
    "key_shapes": [
      "-----BEGIN [A-Z ]*PRIVATE KEY-----",
      "\\b(?:AKIA|ASIA)[0-9A-Z]{16}\\b",
      "\\bgh[pousr]_[A-Za-z0-9]{36,}\\b",
      "\\bgithub_pat_[A-Za-z0-9_]{40,}\\b",
      "\\bxox[baprs]-[A-Za-z0-9-]{10,}\\b",
      "\\bsk-ant-[A-Za-z0-9_-]{20,}\\b",
      "\\bsk-proj-[A-Za-z0-9_-]{32,}\\b",
      "\\bsk-[A-Za-z0-9]{32,}\\b",
      "\\bAIza[0-9A-Za-z_-]{35}\\b",
      "\\b[rs]k_live_[A-Za-z0-9]{20,}\\b",
      "\\bnpm_[A-Za-z0-9]{36}\\b",
      "\\bSG\\.[A-Za-z0-9_-]{22}\\.[A-Za-z0-9_-]{43}\\b"
    ],
    "secret_files": [
      "{HOME}\\/\\.ssh(?:\\/(?![^\\s'\"]*\\.pub(?=$|[\\s'\"|;&)]))[^\\s'\"|;&)]*|(?=$|[\\s'\"|;&)]))",
      "(?:^|[\\s'\"=@<:/])id_(?:rsa|dsa|ecdsa|ed25519)(?!\\.pub)(?=$|[\\s'\"|;&)])",
      "\\.aws\\/(?:credentials|config)\\b",
      "(?:^|[\\s'\"=@<:/])\\.env(?:\\.(?!example\\b|sample\\b|template\\b|dist\\b|defaults?\\b)[\\w-]+)?(?=$|[\\s'\"|;&)<>])",
      "\\.netrc\\b",
      "\\.git-credentials\\b",
      "\\.npmrc\\b",
      "\\.pypirc\\b",
      "\\.docker\\/config\\.json\\b",
      "\\.kube\\/config\\b",
      "\\/etc\\/shadow\\b",
      "\\.config\\/gh\\/hosts\\.yml\\b",
      "\\.atris\\/credentials",
      "\\.gnupg\\/"
    ],
    "safe_net": {
      "curl": {
        "flags": [
          "-s",
          "--silent",
          "-S",
          "--show-error",
          "-f",
          "--fail",
          "--fail-with-body",
          "--fail-early",
          "-L",
          "--location",
          "-O",
          "--remote-name",
          "-i",
          "--include",
          "-v",
          "--verbose",
          "--compressed",
          "-G",
          "--get"
        ],
        "values": [
          "-H",
          "--header",
          "-d",
          "--data",
          "--data-raw",
          "--data-binary",
          "--data-urlencode",
          "--data-ascii",
          "--json",
          "-X",
          "--request",
          "-o",
          "--output",
          "-w",
          "--write-out",
          "-m",
          "--max-time"
        ],
        "local_values": [
          "-o",
          "--output"
        ],
        "short_flags": "sSfLOivG",
        "short_values": "HdXowm",
        "items": false
      },
      "wget": {
        "flags": [
          "-q",
          "--quiet",
          "-S",
          "--server-response",
          "-nv",
          "--no-verbose"
        ],
        "values": [
          "-O",
          "--output-document",
          "--header",
          "--post-data",
          "--method",
          "--body-data",
          "-T",
          "--timeout",
          "-t",
          "--tries"
        ],
        "local_values": [
          "-O",
          "--output-document"
        ],
        "short_flags": "qS",
        "short_values": "OTt",
        "items": false
      },
      "http": {
        "flags": [
          "-j",
          "--json",
          "-f",
          "--form",
          "-h",
          "--headers",
          "-b",
          "--body",
          "-v",
          "--verbose",
          "--check-status",
          "--ignore-stdin"
        ],
        "values": [
          "-p",
          "--print",
          "--timeout",
          "-o",
          "--output"
        ],
        "local_values": [
          "-o",
          "--output"
        ],
        "short_flags": "jfhbv",
        "short_values": "po",
        "items": true
      }
    },
    "safe_net_aliases": {
      "https": "http",
      "xh": "http",
      "httpie": "http"
    },
    "read_only": [
      "cat",
      "less",
      "more",
      "head",
      "tail",
      "grep",
      "egrep",
      "fgrep",
      "rg",
      "jq",
      "ls",
      "stat",
      "wc",
      "file",
      "diff",
      "echo",
      "test",
      "[",
      "realpath",
      "readlink"
    ],
    "read_only_git": [
      "diff",
      "log",
      "show",
      "status"
    ],
    "db_clients": [
      "psql",
      "pg_restore",
      "mysql",
      "mariadb",
      "sqlite3",
      "sqlite",
      "sqlcmd",
      "mongosh",
      "mongo",
      "redis-cli",
      "clickhouse-client",
      "clickhouse",
      "cockroach",
      "duckdb",
      "supabase",
      "prisma",
      "turso",
      "wrangler",
      "neonctl",
      "cqlsh"
    ],
    "drop_text": "\\bdrop\\s+(?:database|schema)\\b|\\.dropDatabase\\s*\\(|\\bflushall\\b|\\bflushdb\\b",
    "command_patterns": [
      {
        "id": "exfil-interpreter-env-net",
        "category": "exfil",
        "programs": [
          "python",
          "python3",
          "python2",
          "node",
          "perl",
          "ruby",
          "php"
        ],
        "pattern": "(?:urlopen|requests\\.|http\\.client|https?\\.request|Net::HTTP|fetch\\s*\\(|socket\\.|TCPSocket)[\\s\\S]*(?:environ|getenv|process\\.env|ENV\\[)|(?:environ|getenv|process\\.env|ENV\\[)[\\s\\S]*(?:urlopen|requests\\.|http\\.client|https?\\.request|Net::HTTP|fetch\\s*\\(|socket\\.|TCPSocket)"
      }
    ]
  },
  "agents": {
    "secret_key_name": "(?:^|_|-)(?:api[_-]?key|key|token|secret|password|passwd|pat|credential|credentials|auth)(?:$|_|-)",
    "download": "(?:curl|wget|fetch|iwr|Invoke-WebRequest|irm|Invoke-RestMethod)\\b",
    "download_run": [
      "{DOWNLOAD}[^\\n|;&]*\\|\\s*(?:sudo\\s+)?(?:env\\s+)?(?:ba|z|da|k|fi)?sh\\b",
      "{DOWNLOAD}[^\\n|;&]*\\|\\s*(?:sudo\\s+)?(?:python[0-9.]*|node|perl|ruby|php|iex|Invoke-Expression)\\b",
      "(?:ba|z|k)?sh\\s+<\\(\\s*{DOWNLOAD}",
      "(?:ba|z|k)?sh\\s+-c\\s+[\"']?\\$\\(\\s*{DOWNLOAD}",
      "source\\s+<\\(\\s*{DOWNLOAD}"
    ],
    "eval_fetched": [
      "\\beval\\s+[\"']?\\$\\(\\s*{DOWNLOAD}",
      "\\beval\\s+[\"']?`\\s*{DOWNLOAD}",
      "\\beval\\s*\\(\\s*(?:await\\s+)?\\(?\\s*(?:await\\s+)?fetch\\s*\\(",
      "\\bexec\\s*\\(\\s*(?:urllib\\.request\\.)?urlopen\\s*\\(",
      "\\bexec\\s*\\(\\s*requests\\.get\\s*\\("
    ],
    "skip_flags": "(?:^|\\s)(?:--dangerously-skip-permissions|--dangerously-bypass-approvals-and-sandbox|--yolo|--permission-mode[ =]bypassPermissions|--approval-mode[ =]yolo|--allow-dangerously-skip-permissions)(?=\\s|$|[\"'])",
    "override_phrases": [
      "\\b(?:ignore|disregard|forget|override|bypass)\\s+(?:all\\s+|any\\s+|every\\s+)?(?:of\\s+)?(?:the\\s+|your\\s+|my\\s+)?(?:previous|prior|above|earlier|preceding|original|system|other)\\s+(?:instructions?|prompts?|rules|directions|guidelines|messages)\\b",
      "\\byou\\s+are\\s+now\\s+(?:in\\s+)?(?:developer|dan|jailbreak|god)\\s+mode\\b",
      "\\b(?:do\\s+not|don't|never)\\s+(?:tell|inform|show)\\s+the\\s+user\\s+(?:about|that|what|anything|this|you\\b|we\\b)",
      "\\b(?:do\\s+not|don't|never)\\s+mention\\s+(?:this|it)\\s+to\\s+the\\s+user\\b",
      "\\bwithout\\s+(?:telling|informing|alerting)\\s+the\\s+user\\b",
      "\\bhide\\s+this\\s+from\\s+the\\s+user\\b",
      "\\bnew\\s+system\\s+prompt\\s*:"
    ],
    "comment_directive": "\\b(?:ignore\\s+(?:the|all|any|previous|prior|above)|disregard|secretly|silently|do\\s+not\\s+tell|don't\\s+tell|without\\s+telling|curl|wget|exfiltrate|send\\s+(?:the|all|any|your)\\s+\\w+\\s+to|system\\s+prompt|you\\s+are\\s+(?:now|an?|the)|you\\s+must|always\\s+run|run\\s+the\\s+following|execute\\s+(?:the|this))\\b"
  }
}
