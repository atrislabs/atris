{
  "version": 2,
  "guard": {
    "allow_hosts": [
      "localhost",
      "127.0.0.1",
      "0.0.0.0",
      "::1",
      "api.github.com",
      "github.com",
      "uploads.github.com",
      "api.openai.com",
      "api.anthropic.com",
      "registry.npmjs.org",
      "pypi.org",
      "upload.pypi.org",
      "api.atris.ai",
      "atris.ai",
      "api.stripe.com",
      "slack.com",
      "api.vercel.com",
      "api.render.com"
    ],
    "net_tools": [
      "curl",
      "wget",
      "nc",
      "ncat",
      "netcat",
      "socat",
      "telnet",
      "scp",
      "sftp",
      "ftp",
      "rsync",
      "http",
      "https",
      "xh",
      "httpie",
      "aria2c",
      "lftp",
      "ssh"
    ],
    "secret_parts": [
      "KEY",
      "KEYS",
      "TOKEN",
      "TOKENS",
      "SECRET",
      "SECRETS",
      "PASSWORD",
      "PASSWD",
      "PASS",
      "PWD",
      "CREDENTIAL",
      "CREDENTIALS",
      "CREDS",
      "AUTH",
      "PRIVATE",
      "SESSION",
      "COOKIE",
      "APIKEY",
      "PAT",
      "DSN"
    ],
    "safe_net": {
      "curl": {
        "flags": [
          "-s",
          "--silent",
          "-S",
          "--show-error",
          "-f",
          "--fail",
          "--fail-with-body",
          "--fail-early",
          "-L",
          "--location",
          "-O",
          "--remote-name",
          "-i",
          "--include",
          "-v",
          "--verbose",
          "--compressed",
          "-G",
          "--get"
        ],
        "values": [
          "-H",
          "--header",
          "-d",
          "--data",
          "--data-raw",
          "--data-binary",
          "--data-urlencode",
          "--data-ascii",
          "--json",
          "-X",
          "--request",
          "-o",
          "--output",
          "-w",
          "--write-out",
          "-m",
          "--max-time"
        ],
        "local_values": [
          "-o",
          "--output"
        ],
        "short_flags": "sSfLOivG",
        "short_values": "HdXowm",
        "items": false
      },
      "wget": {
        "flags": [
          "-q",
          "--quiet",
          "-S",
          "--server-response",
          "-nv",
          "--no-verbose"
        ],
        "values": [
          "-O",
          "--output-document",
          "--header",
          "--post-data",
          "--method",
          "--body-data",
          "-T",
          "--timeout",
          "-t",
          "--tries"
        ],
        "local_values": [
          "-O",
          "--output-document"
        ],
        "short_flags": "qS",
        "short_values": "OTt",
        "items": false
      },
      "http": {
        "flags": [
          "-j",
          "--json",
          "-f",
          "--form",
          "-h",
          "--headers",
          "-b",
          "--body",
          "-v",
          "--verbose",
          "--check-status",
          "--ignore-stdin"
        ],
        "values": [
          "-p",
          "--print",
          "--timeout",
          "-o",
          "--output"
        ],
        "local_values": [
          "-o",
          "--output"
        ],
        "short_flags": "jfhbv",
        "short_values": "po",
        "items": true
      }
    },
    "safe_net_aliases": {
      "https": "http",
      "xh": "http",
      "httpie": "http"
    },
    "read_only": [
      "cat",
      "less",
      "more",
      "head",
      "tail",
      "grep",
      "egrep",
      "fgrep",
      "rg",
      "jq",
      "ls",
      "stat",
      "wc",
      "file",
      "diff",
      "echo",
      "test",
      "[",
      "realpath",
      "readlink"
    ],
    "read_only_git": [
      "diff",
      "log",
      "show",
      "status"
    ],
    "db_clients": [
      "psql",
      "pg_restore",
      "mysql",
      "mariadb",
      "sqlite3",
      "sqlite",
      "sqlcmd",
      "mongosh",
      "mongo",
      "redis-cli",
      "clickhouse-client",
      "clickhouse",
      "cockroach",
      "duckdb",
      "supabase",
      "prisma",
      "turso",
      "wrangler",
      "neonctl",
      "cqlsh"
    ],
    "command_blocks": [
      {
        "id": "inline-secret-out",
        "category": "exfil",
        "all": [],
        "inline": true,
        "needs_secret": true,
        "needs_remote": true
      }
    ]
  },
  "agents": {
    "override_substrings": [],
    "secret_env_names": []
  }
}
