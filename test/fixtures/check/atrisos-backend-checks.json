{
  "version": 1,
  "note": "Which checks a change needs, picked by plain rules (atris check --explain shows why and how long). Low risk (docs, comments, tests) runs only quick checks. Normal runs the few tests that cover the change (the tests selector). High risk runs those first, then the whole release gate (fast-gate). A changed file no test covers falls back to fast-gate and is printed, so the gap gets seen. backend/main.py imports every router, so it is not counted as an importer (import-preflight checks that the app still starts).",
  "checks": {
    "tests": {
      "select": "pytest",
      "roots": [
        "backend/tests"
      ],
      "when": [
        "backend/**",
        "supabase/**"
      ],
      "cwd": "backend",
      "python": "venv/bin/python",
      "run": "{python} -m pytest -q --tb=short --disable-warnings -p no:cacheprovider -p pytest_mock -p anyio.pytest_plugin {parallel} {files}",
      "env": {
        "PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1",
        "PYTHONPATH": ".",
        "OFFLINE_MODE": "1",
        "ENV": "development",
        "JWT_SECRET": "test",
        "VAULT_JWT_SECRET": "test",
        "SUPABASE_URL": "http://localhost",
        "SUPABASE_ANON_KEY": "anon",
        "SUPABASE_SERVICE_KEY": "service"
      },
      "max": 80,
      "fallback": "fast-gate",
      "seconds": 22,
      "per_test_seconds": 1,
      "timeout_seconds": 600
    },
    "fast-gate": {
      "run": "bash backend/scripts/test_fast.sh",
      "where": "here",
      "risk": "sign-in",
      "tier": "high",
      "seconds": 120,
      "timeout_seconds": 900
    },
    "import-preflight": {
      "run": "python3 atris/skills/deploy-preflight/scripts/check_imports.py",
      "where": "here",
      "when": [
        "backend/main.py",
        "backend/routers/**",
        "atris/skills/deploy-preflight/**"
      ],
      "risk": "release",
      "seconds": 2
    },
    "map-valid": {
      "run": "python3 scripts/validate_map.py",
      "where": "here",
      "tier": "low",
      "when": [
        "atris/MAP.md",
        "atris/map/**",
        "scripts/validate_map.py"
      ],
      "seconds": 1
    }
  },
  "risk": {
    "low": [
      "**/*.md",
      "docs/**",
      "atris/**/*.md",
      "atris/logs/**",
      "atris/**/*.jsonl",
      "atris/**/*.txt"
    ],
    "high": {
      "sign-in": [
        "backend/routers/auth*",
        "backend/routers/*_auth*",
        "backend/routers/sdk_auth.py",
        "backend/routers/oauth_*",
        "backend/auth.py",
        "backend/services/*auth*"
      ],
      "access": [
        "backend/routers/business/members.py",
        "backend/routers/business/memberships.py",
        "backend/routers/members_router.py",
        "backend/routers/agent/member.py",
        "backend/routers/auth_scopes_router.py",
        "backend/services/*member*",
        "backend/services/*access*"
      ],
      "money": [
        "backend/routers/*billing*",
        "backend/routers/*credit*",
        "backend/routers/*wallet*",
        "backend/routers/*pay*",
        "backend/routers/stripe*",
        "backend/routers/integrations/stripe*",
        "backend/services/*billing*",
        "backend/services/*credit*",
        "backend/services/*wallet*",
        "backend/services/*stripe*",
        "backend/services/*pay*"
      ],
      "security": [
        "backend/routers/*api_key*",
        "backend/routers/vault*",
        "backend/services/*secret*",
        "backend/services/*vault*",
        "backend/services/*api_key*",
        "backend/services/*security*"
      ],
      "release": [
        "render.yaml",
        "**/Dockerfile",
        "backend/requirements*.txt",
        "requirements*.txt",
        ".github/workflows/**",
        "backend/main.py",
        "backend/scripts/test_fast.sh",
        "backend/scripts/test_land.sh",
        "backend/scripts/land_select.py",
        "backend/scripts/pick_python.sh",
        "**/conftest.py",
        "pytest.ini",
        "pyproject.toml",
        "backend/pyproject.toml",
        "backend/tests/__init__.py"
      ]
    }
  },
  "gates": {
    "release": [
      "fast-gate",
      "import-preflight"
    ]
  },
  "default": [
    "tests"
  ],
  "importers_except": [
    "backend/main.py"
  ]
}
